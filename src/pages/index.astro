---
// Review index for the client: links to the hub, the five landings and the component sheet.
// Not part of the future public site.
import Base from '../layouts/Base.astro';
import Pattern from '../components/Pattern.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo.svg?raw';
import { scenarios, toneStyle } from '../data/scenarios';
import { site } from '../data/site';

const pages = [
  { num: 'Хаб', title: site.navLabel, text: 'Общая страница раздела: все форматы сотрудничества, производство, ассортимент, поддержка, логистика, FAQ и заявка.', href: site.hubPath, style: 'background:var(--c-ink);color:var(--c-white)' },
  ...scenarios.map((s) => ({ num: s.num, title: s.title, text: s.promise, href: s.href, style: toneStyle(s.tone) })),
];
const notes = [
  'Страницы адаптивные: откройте их на телефоне или сузьте окно браузера (1440, 768, 390).',
  'Форма работает в демо-режиме: проверяет поля, но заявки пока никуда не отправляет.',
  'Тексты на русском для согласования, по стратегии и сценариям роликов. Испанская версия будет переводом после утверждения.',
  'Фото взяты с miradex.bg и будут заменены на испанские объекты. Ролики пока заглушки.',
];
---
<Base title="MIRADEX España · B2B · черновик" noindex>
  <div class="ix">
    <div class="container ix__in">
      <header class="ix__head">
        <span class="ix__logo" set:html={logo} />
        <div class="ix__pattern"><Pattern seed="index" cols={3} units={6} /></div>
        <h1 class="h2">Раздел «Сотрудничество» для MIRADEX España</h1>
        <p class="lead muted">Черновик для согласования: хаб и пять лендингов. Выберите страницу.</p>
      </header>

      <ol class="ix__list" role="list">
        {pages.map((p) => (
          <li>
            <a class="ix__card" href={p.href}>
              <span class="ix__num" style={p.style}>{p.num}</span>
              <span class="ix__body"><span class="ix__title">{p.title}</span><span class="ix__text">{p.text}</span></span>
              <Icon name="arrow-up-right" size={22} />
            </a>
          </li>
        ))}
      </ol>

      <section class="ix__notes">
        <p class="eyebrow">Как смотреть</p>
        <ul role="list">{notes.map((n) => <li><Icon name="check" size={18} /><span>{n}</span></li>)}</ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .ix { padding-block: clamp(40px, 2rem + 4vw, 96px); background: var(--bg-tint); min-height: 100vh; }
  .ix__in { display: grid; gap: var(--sp-8); max-width: 1000px; }
  .ix__head { display: grid; gap: var(--sp-4); justify-items: start; }
  .ix__logo { width: 150px; color: var(--c-ink); }
  .ix__logo :global(svg) { width: 100%; height: auto; }
  .ix__pattern { width: min(420px, 100%); margin-top: var(--sp-5); }
  .ix__list { display: grid; gap: 10px; }
  .ix__card {
    display: grid; grid-template-columns: 64px 1fr 24px; gap: var(--sp-5); align-items: center; padding: var(--sp-5);
    border-radius: var(--radius-md); background: var(--c-white); color: var(--text); text-decoration: none; border: 1px solid var(--border);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .ix__card:hover { border-color: var(--c-blue); transform: translateY(-2px); }
  .ix__num { display: grid; place-items: center; height: 48px; border-radius: var(--radius-sm); font-weight: var(--fw-medium); font-size: var(--fs-small); }
  .ix__body { display: grid; gap: 4px; }
  .ix__title { font-weight: var(--fw-medium); text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .ix__text { color: var(--text-muted); font-size: var(--fs-small); }
  .ix__notes { display: grid; gap: var(--sp-4); padding: var(--sp-6); border-radius: var(--radius-md); background: var(--c-white); }
  .ix__notes .eyebrow { color: var(--text-muted); }
  .ix__notes ul { display: grid; gap: var(--sp-3); }
  .ix__notes li { display: grid; grid-template-columns: 22px 1fr; gap: var(--sp-3); color: var(--text-muted); }
  .ix__notes li :global(svg) { color: var(--c-blue); margin-top: 3px; }
  @media (max-width: 767px) { .ix__card { grid-template-columns: 48px 1fr 22px; gap: var(--sp-4); padding: var(--sp-4); } }
</style>
