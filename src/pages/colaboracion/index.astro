---
// Hub «Сотрудничество»: helps a visitor quickly see where to go, by format or by business type (strategy 5).
// One story, nine blocks: choice → film and the open model → your business → why MIRADEX (production, range and
// logistics as one block) → support and training → projects → FAQ → form. Each fact is shown once.
// Content: src/data/hub.ts.
import Page from '../../layouts/Page.astro';
import HubHero from '../../components/HubHero.astro';
import Section from '../../components/Section.astro';
import ScenarioBanners from '../../components/ScenarioBanners.astro';
import BusinessQuiz from '../../components/BusinessQuiz.astro';
import SectorCards from '../../components/SectorCards.astro';
import VideoPlaceholder from '../../components/VideoPlaceholder.astro';
import ModelPillars from '../../components/ModelPillars.astro';
import FactsStrip from '../../components/FactsStrip.astro';
import SplitFeature from '../../components/SplitFeature.astro';
import CategoryCards from '../../components/CategoryCards.astro';
import SupportGroups from '../../components/SupportGroups.astro';
import SamplesStrip from '../../components/SamplesStrip.astro';
import LogisticsTrack from '../../components/LogisticsTrack.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import Faq from '../../components/Faq.astro';
import FinalForm from '../../components/FinalForm.astro';
import Icon from '../../components/Icon.astro';
import { hub } from '../../data/hub';
import { videos } from '../../data/videos';
import { finalPoints } from '../../data/shared';
import { ui } from '../../data/ui';

const v1 = videos[1];
---
<Page title={hub.meta.title} description={hub.meta.description}>
  <!-- 1 · First screen: the format choice is the main action, the short application is secondary -->
  <HubHero title={hub.hero.title} lead={hub.hero.lead} image={hub.hero.image} />

  <!-- 2 · The five formats in detail -->
  <Section id="formatos" tone="grey" title={hub.formats.title} lead={hub.formats.lead}>
    <ScenarioBanners />
  </Section>

  <!-- 3 · Film №1 + the open national model -->
  <Section id="video" title={hub.video.title} lead={hub.video.lead}>
    <div class="film">
      <VideoPlaceholder num={v1.num} title={v1.title} duration={v1.duration} poster={v1.poster} />
      <ModelPillars items={hub.pillars} compact />
    </div>
  </Section>

  <!-- 4 · Second path: «Какой у меня бизнес?» (strategy 5.2); the quiz is folded for mixed businesses -->
  <Section id="negocios" tone="tint" title={ui.sector.title}>
    <SectorCards />
    <details class="hub-quiz">
      <summary class="hub-quiz__sum">
        <span class="hub-quiz__title">{hub.quiz.title}</span>
        <span class="btn btn--primary hub-quiz__btn"><span>{hub.quiz.open}</span><Icon name="chevron-down" size={18} /></span>
      </summary>
      <div class="hub-quiz__body"><p class="hub-quiz__lead">{hub.quiz.lead}</p><BusinessQuiz /></div>
    </details>
  </Section>

  <!-- 5 · Why MIRADEX: key numbers, then production, range and logistics as parts of one block -->
  <Section id="por-que" title={hub.why.title} lead={hub.why.lead}>
    <FactsStrip facts={ui.hubFacts} />

    <div class="why-part">
      <h3 class="why-part__title">{hub.production.title}</h3>
      <SplitFeature items={hub.production.items} media={{ src: '/img/photos/texture-graphite.jpg', alt: 'Стальные ламели MIRADEX' }} aside={hub.production.aside} />
    </div>

    <div class="why-part">
      <h3 class="why-part__title">{hub.range.title}</h3>
      <p class="why-part__lead">{hub.range.lead}</p>
      <CategoryCards />
    </div>

    <div class="why-part">
      <h3 class="why-part__title">{hub.logistics.title}</h3>
      <p class="why-part__lead">{hub.logistics.lead}</p>
      <LogisticsTrack stages={hub.logistics.stages} total={hub.logistics.total} />
    </div>
  </Section>

  <!-- 6 · Support and training -->
  <Section id="apoyo" tone="tint" title={hub.support.title} lead={hub.support.lead}>
    <SupportGroups groups={hub.support.groups} />
    <SamplesStrip />
  </Section>

  <!-- 7 · Projects -->
  <Section id="proyectos" title={hub.projects.title} lead={hub.projects.lead}>
    <ProjectGallery />
  </Section>

  <!-- 8 · FAQ -->
  <Section id="faq" tone="tint" title="Частые вопросы">
    <Faq items={hub.faq} />
  </Section>

  <!-- 9 · Form -->
  <FinalForm title={hub.final.title} text={hub.final.text} points={finalPoints} />
</Page>

<style>
  /* film and the three pillars side by side, so the block is one screen, not two */
  /* the film takes the height of the pillars column */
  .film { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--grid-gap); align-items: stretch; }
  .film > :global(.video) { height: 100%; }
  .film :global(.video__frame) { height: 100%; aspect-ratio: auto; min-height: 360px; }
  @media (max-width: 1023px) {
    .film { grid-template-columns: 1fr; }
    .film :global(.video__frame) { height: auto; aspect-ratio: 16 / 9; min-height: 0; }
  }

  /* quiz folded under the cards: one click opens it, so the 16 businesses are not shown twice */
  .hub-quiz { margin-top: 8px; border-radius: var(--radius-sm); background: var(--c-white); }
  .hub-quiz__sum { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-5); min-height: 64px; padding: 10px 10px 10px 20px; cursor: pointer; }
  .hub-quiz__sum::-webkit-details-marker { display: none; }
  .hub-quiz__title { font-size: var(--fs-body); font-weight: var(--fw-medium); line-height: 1.3; }
  .hub-quiz__lead { color: var(--text-muted); font-size: var(--fs-small); max-width: 60ch; margin-bottom: var(--sp-5); }
  /* the quiz is a real second path, so its button is a primary one */
  .hub-quiz__btn { flex: none; --btn-h: 48px; }
  .hub-quiz__btn :global(svg) { transition: transform var(--dur) var(--ease); }
  .hub-quiz[open] .hub-quiz__btn :global(svg) { transform: rotate(180deg); }
  .hub-quiz__sum:hover .hub-quiz__btn { background: var(--c-blue-hover); }
  .hub-quiz__body { padding: var(--sp-2) var(--sp-5) var(--sp-6); }

  /* parts of «Почему MIRADEX» */
  .why-part { display: grid; gap: var(--sp-4); margin-top: clamp(48px, 2rem + 3vw, 88px); }
  .why-part__title { font-size: var(--fs-h3); }
  .why-part__lead { color: var(--text-muted); max-width: 60ch; margin-bottom: var(--sp-3); }

  @media (max-width: 767px) {
    .hub-quiz__sum { flex-direction: column; align-items: stretch; padding: var(--sp-4); }
    .hub-quiz__btn { justify-content: center; }
    .hub-quiz__body { padding: 0 var(--sp-4) var(--sp-5); }
  }
</style>
