---
// Hub «Сотрудничество»: explains the whole B2B system and routes to the 5 landings, by format and by business type.
// Content: src/data/hub.ts.
import Page from '../../layouts/Page.astro';
import HubHero from '../../components/HubHero.astro';
import Section from '../../components/Section.astro';
import ScenarioBanners from '../../components/ScenarioBanners.astro';
import BusinessQuiz from '../../components/BusinessQuiz.astro';
import SectorCards from '../../components/SectorCards.astro';
import VideoPlaceholder from '../../components/VideoPlaceholder.astro';
import WhyMiradex from '../../components/WhyMiradex.astro';
import ModelPillars from '../../components/ModelPillars.astro';
import CtaBand from '../../components/CtaBand.astro';
import SplitFeature from '../../components/SplitFeature.astro';
import Stats from '../../components/Stats.astro';
import CategoryCards from '../../components/CategoryCards.astro';
import SupportGroups from '../../components/SupportGroups.astro';
import LogisticsTrack from '../../components/LogisticsTrack.astro';
import Gallery from '../../components/Gallery.astro';
import Faq from '../../components/Faq.astro';
import FinalForm from '../../components/FinalForm.astro';
import { hub } from '../../data/hub';
import { videos } from '../../data/videos';
import { productStats, statsFootnote, finalPoints } from '../../data/shared';
import { ui } from '../../data/ui';

const v1 = videos[1];
---
<Page title={hub.meta.title} description={hub.meta.description}>
  <!-- 1 · First screen on white: formats and a short application, photo on the right half -->
  <HubHero title={hub.hero.title} lead={hub.hero.lead} image={hub.hero.image} />

  <!-- 2 · The choice: five formats as banners -->
  <Section id="formatos" tone="grey" title={hub.formats.title} lead={hub.formats.lead}>
    <ScenarioBanners />
  </Section>

  <!-- 3 · Video №1 + how the model works -->
  <Section id="video" title={hub.video.title} lead={hub.video.lead}>
    <VideoPlaceholder num={v1.num} title={v1.title} duration={v1.duration} poster={v1.poster} />
    <div class="gap-top"><ModelPillars items={hub.pillars} /></div>
  </Section>

  <!-- 4 · Second path: «Какой у меня бизнес?» (strategy 5.2), every audience opens its industry page;
       below, the two-question quiz for mixed or unlisted businesses -->
  <Section id="negocios" tone="tint" title={ui.sector.title} lead={ui.sector.lead}>
    <SectorCards />
    <div class="hub-quiz">
      <h3 class="hub-quiz__title">{hub.quiz.title}</h3>
      <p class="hub-quiz__lead">{hub.quiz.lead}</p>
      <BusinessQuiz />
    </div>
  </Section>

  <!-- 4 · Why MIRADEX -->
  <WhyMiradex id="por-que" title={hub.why.title} />

  <!-- 5 · Production -->
  <Section id="produccion" title={hub.production.title} lead={hub.production.lead}>
    <SplitFeature items={hub.production.items} media={{ src: '/img/photos/texture-graphite.jpg', alt: 'Стальные ламели MIRADEX', placeholder: ui.photoFactory }} aside={hub.production.aside} />
  </Section>

  <!-- 6 · Range -->
  <Section id="gama" tone="tint" title={hub.range.title} lead={hub.range.lead}>
    <Stats stats={productStats} footnote={statsFootnote} />
    <div class="gap-top"><CategoryCards /></div>
  </Section>

  <!-- 7 · Support -->
  <Section id="apoyo" title={hub.support.title} lead={hub.support.lead}>
    <SupportGroups groups={hub.support.groups} />
  </Section>

  <!-- 8 · Training -->
  <Section id="formacion" tone="tint" title={hub.training.title} lead={hub.training.lead}>
    <SplitFeature items={hub.training.items} media={{ src: '/img/photos/tisa-wood-stone.jpg', alt: 'Установленный забор Tisa' }} reverse />
  </Section>

  <!-- 9 · Logistics -->
  <Section id="logistica" title={hub.logistics.title} lead={hub.logistics.lead}>
    <LogisticsTrack stages={hub.logistics.stages} total={hub.logistics.total} notes={hub.logistics.notes} />
  </Section>

  <!-- 10 · Projects -->
  <Section id="proyectos" tone="tint" title={hub.projects.title} lead={hub.projects.lead}>
    <Gallery items={hub.projects.gallery}>
      <article class="ref">
        <p class="eyebrow ref__eyebrow">{hub.projects.ref.eyebrow}</p>
        <h3 class="ref__title">{hub.projects.ref.title}</h3>
        <p class="ref__text">{hub.projects.ref.text}</p>
      </article>
    </Gallery>
  </Section>

  <CtaBand title={hub.cta.title} text={hub.cta.text} tone="mint" scenario="no-se" cta={hub.cta.cta} />

  <!-- 11 · FAQ -->
  <Section id="faq" title="Частые вопросы">
    <Faq items={hub.faq} />
  </Section>

  <!-- 12 · Form -->
  <FinalForm title={hub.final.title} text={hub.final.text} points={finalPoints} />

</Page>

<style>
  .gap-top { margin-top: var(--stack-gap); }
  .hub-quiz { display: grid; gap: var(--sp-3); margin-top: clamp(48px, 2rem + 3vw, 88px); padding-top: clamp(32px, 1rem + 2vw, 48px); border-top: 1px solid var(--border); }
  .hub-quiz__title { font-size: var(--fs-h3); line-height: 1.25; text-transform: none; letter-spacing: 0; }
  .hub-quiz__lead { color: var(--text-muted); max-width: 60ch; margin-bottom: var(--sp-4); }
  .ref { height: 100%; display: flex; flex-direction: column; gap: var(--sp-3); padding: var(--sp-6); border-radius: var(--radius-md); background: var(--bg-accent); color: var(--text-on-accent); }
  .ref__eyebrow { color: var(--c-mint); }
  .ref__title { font-size: var(--fs-h2); }
  .ref__text { color: var(--text-on-accent-muted); max-width: 40ch; }
</style>
