---
// Landing 04 · "Quiero recomendar clientes" (referral programme). Sources: strategy 3.4, 7.1 (stand + QR),
// pricing model (referral: reward depends on order size, no numbers published); video script nº11.
import Page from '../../layouts/Page.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import VideoPlaceholder from '../../components/VideoPlaceholder.astro';
import WhyMiradex from '../../components/WhyMiradex.astro';
import CtaBand from '../../components/CtaBand.astro';
import ScenarioLinks from '../../components/ScenarioLinks.astro';
import Economics from '../../components/Economics.astro';
import SupportGroups from '../../components/SupportGroups.astro';
import Responsibilities from '../../components/Responsibilities.astro';
import Stats from '../../components/Stats.astro';
import CategoryCards from '../../components/CategoryCards.astro';
import FitList from '../../components/FitList.astro';
import Steps from '../../components/Steps.astro';
import Gallery from '../../components/Gallery.astro';
import Faq from '../../components/Faq.astro';
import FinalForm from '../../components/FinalForm.astro';
import { scenarioById } from '../../data/scenarios';
import { productStats, statsFootnote, faq as commonFaq, finalPoints } from '../../data/shared';

const s = scenarioById('recomendar')!;

const drivers = [
  { icon: 'hand-coins', title: 'Recompensa por venta', text: 'Recibe una recompensa por cada venta realizada con su recomendación.' },
  { icon: 'shield-check', title: 'Sin vender', text: 'No compra producto ni asume responsabilidad técnica de la venta.' },
  { icon: 'link', title: 'Enlace o QR personal', text: 'Comparta su enlace o código QR con sus clientes.' },
  { icon: 'badge-check', title: 'Origen registrado', text: 'El sistema registra de qué socio llega cada cliente.' },
  { icon: 'briefcase', title: 'Su negocio no cambia', text: 'No necesita crear una nueva línea de ventas.' },
  { icon: 'heart-handshake', title: 'Cliente bien atendido', text: 'MIRADEX acompaña a su cliente desde la elección hasta la entrega.' },
];

const ways = [
  { icon: 'link', title: 'Enlace o código QR', text: 'Comparta su enlace personal con sus clientes en mensajes, redes o documentos del proyecto.' },
  { icon: 'qr-code', title: 'Expositor con QR', text: 'Expositor con muestras en su tienda, showroom u oficina. El cliente escanea el QR y MIRADEX se encarga del resto.' },
];

const sources = [
  { title: 'Recompensa por venta realizada', text: 'Se paga cuando su cliente compra.' },
  { title: 'Según el importe del pedido', text: 'Cuanto mayor es el pedido, mayor es la recompensa.' },
  { title: 'Sin inversión', text: 'No compra producto, no calcula pedidos y no negocia con el cliente.' },
];

const support = [
  { icon: 'link', title: 'Herramientas', items: ['Enlace personal', 'Código QR', 'Registro del origen del cliente'] },
  { icon: 'image', title: 'Materiales', items: ['Fotos y catálogo para presentar MIRADEX', 'Muestras de colores y acabados'] },
  { icon: 'qr-code', title: 'Expositores', items: ['Expositor con muestras para tienda u oficina', 'Su QR personal en el expositor'] },
  { icon: 'headset', title: 'Atención a su cliente', items: ['Consulta y elección de modelo', 'Cálculo y pedido', 'Producción, entrega e instalación si hace falta'] },
];

const steps = [
  { title: 'Solicitud', text: 'Nos cuenta a qué se dedica.' },
  { title: 'Registro', text: 'Le damos de alta como socio.' },
  { title: 'Enlace o QR', text: 'Recibe su enlace y código QR personal.' },
  { title: 'Recomendación', text: 'Comparte MIRADEX con sus clientes.' },
  { title: 'Venta', text: 'MIRADEX asesora, calcula y vende.' },
  { title: 'Recompensa', text: 'Recibe su recompensa por la venta realizada.' },
];

const sectors = [
  { icon: 'pencil-ruler', title: 'Arquitectos y diseñadores', text: 'Valla, puertas y fachada en un mismo concepto para su proyecto, y una recompensa por recomendarlo.' },
  { icon: 'key-round', title: 'Inmobiliarias', text: 'Después de la compra, el cliente necesita cerramiento: recomiende MIRADEX.' },
  { icon: 'trees', title: 'Paisajismo y piscinas', text: 'Cerramiento y privacidad como parte del proyecto del jardín.' },
  { icon: 'store', title: 'Tiendas y showrooms', text: 'Expositor con muestras y QR para sus clientes.' },
];
const gallery = [
  { src: '/img/photos/piramida-garden.jpg', caption: 'Piramida · Gris grafito RAL 7024' },
  { src: '/img/photos/simetrica-black.jpg', caption: 'Simetrica · Negro RAL 9005' },
  { src: '/img/photos/siding-wood.jpg', caption: 'Revestimiento · Roble dorado' },
  { src: '/img/photos/atlas-wood-house.jpg', caption: 'Atlas · Nogal oscuro' },
];

const faq = [
  { q: '¿Tengo que vender?', a: '<p>No. Usted recomienda. MIRADEX asesora, calcula, vende y acompaña al cliente.</p>' },
  { q: '¿Cómo se registra que el cliente viene de mí?', a: '<p>Con su enlace personal, código o QR. El sistema registra de qué socio llega cada cliente.</p>' },
  { q: '¿Cuándo recibo la recompensa?', a: '<p>Cuando la venta se realiza.</p>' },
  { q: '¿De cuánto es la recompensa?', a: '<p>Depende del importe del pedido. Al registrarse le explicamos la escala.</p>' },
  { q: '¿Necesito comprar producto?', a: '<p>No. No compra producto ni asume responsabilidad técnica.</p>' },
  { q: '¿Puedo poner un expositor?', a: '<p>Sí. Si tiene tienda, showroom u oficina con público, podemos colocar un expositor con muestras y su QR.</p>' },
  { q: '¿Quién instala?', a: '<p>MIRADEX organiza la instalación con socios locales si el cliente lo necesita.</p>' },
  commonFaq.protection,
];
---
<Page
  title="Programa de referidos MIRADEX · Recomiende y reciba una recompensa"
  description="Recomiende las vallas metálicas MIRADEX a sus clientes con su enlace o QR personal. MIRADEX vende y acompaña al cliente; usted recibe una recompensa por cada venta."
  scenario="recomendar"
  current="recomendar"
>
  <!-- 01 · First screen -->
  <Hero
    crumb={{ num: s.num, label: s.short }}
    eyebrow="Para arquitectos, inmobiliarias, paisajismo y tiendas"
    title="Recomiende MIRADEX y reciba una recompensa"
    lead="Usted recomienda. MIRADEX asesora, vende y acompaña al cliente. Usted recibe una recompensa por cada venta realizada."
    scenario="recomendar"
    image={s.image}
    imageAlt="Valla metálica Simetrica en una vivienda"
    note="Sin comprar producto ni ocuparse de la venta."
  />

  <!-- 02 · Why it pays off -->
  <Section id="por-que" tone="tint" title="Por qué le interesa" lead="Ingresos por recomendaciones que ya hace, sin cambiar su negocio.">
    <FeatureGrid items={drivers} />
  </Section>

  <!-- 03 · Video nº11 -->
  <Section id="video" title="El programa en 3 minutos" lead="Cómo funciona, qué hace MIRADEX, a quién le encaja y qué recibe su cliente.">
    <VideoPlaceholder num={s.video.num} title={s.video.title} duration={s.video.duration} poster="/img/photos/piramida-garden.jpg" />
  </Section>

  <WhyMiradex />

  <CtaBand title="¿Sus clientes buscan vallas?" text="Recomiende MIRADEX y reciba una recompensa." scenario="recomendar" cta="Hacerme socio" />

  <!-- 04 · How it works -->
  <Section id="como-funciona" title="Dos formas de recomendar" lead="Elija la que encaja con su trabajo, o use las dos.">
    <FeatureGrid items={ways} cols={2} />
    <div class="gap-top"><ScenarioLinks ids={['vender', 'instalar']} title="¿Quiere vender o instalar usted mismo?" /></div>
  </Section>

  <!-- 05 · Economics -->
  <Section id="economia" tone="tint" title="Cómo gana" lead="Una recompensa por cada venta realizada, sin comprar producto.">
    <Economics
      sources={sources}
      sourcesLabel="Su recompensa"
      principle="La recompensa se paga por ventas realizadas de clientes que llegan con su enlace, código o QR."
      model={{ title: 'Escala de recompensas', text: 'Al registrarse le explicamos la escala según el importe del pedido.' }}
    />
  </Section>

  <!-- 06 · What the partner receives -->
  <Section id="apoyo" title="Qué recibe como socio" lead="Herramientas para recomendar y un equipo que atiende a su cliente.">
    <SupportGroups groups={support} />
  </Section>

  <Section id="funciones" tone="tint" title="MIRADEX hace todo el trabajo" lead="Usted solo recomienda.">
    <Responsibilities
      miradex={[
        'Consulta y ayuda para elegir modelo y acabado',
        'Cálculo y presupuesto',
        'Pedido, producción y entrega',
        'Instalación con socios locales si hace falta',
        'Seguimiento del cliente hasta el final',
      ]}
      partnerTitle="Usted solo"
      partner={['Recomienda MIRADEX', 'Comparte su enlace o QR']}
    />
  </Section>

  <CtaBand title="Hablemos de sus clientes" text="Formulario o WhatsApp: como le resulte más cómodo." tone="dark" scenario="recomendar" cta="Hacerme socio" />

  <!-- 07 · What their client gets -->
  <Section id="producto" title="Qué recibe su cliente" lead="Un fabricante europeo con más de 15 años de experiencia, amplia gama y acompañamiento en todo el proceso.">
    <Stats stats={productStats} footnote={statsFootnote} />
    <div class="gap-top"><CategoryCards /></div>
  </Section>

  <Section id="para-quien" tone="tint" title="¿Es para usted?">
    <FitList
      fit={[
        'Trabaja con propietarios, compradores de vivienda o proyectos.',
        'No quiere vender ni calcular pedidos.',
        'Quiere ingresos extra sin cambiar su negocio.',
        'Tiene tienda, showroom u oficina con público.',
      ]}
      notFit={[
        'Quiere comprar a precio de socio y revender: vea «Vender MIRADEX».',
        'Quiere instalar y ganar con el montaje: vea «Vender e instalar».',
      ]}
    />
  </Section>

  <!-- 08 · How it starts -->
  <Section id="inicio" title="Cómo empieza la colaboración">
    <Steps steps={steps} />
  </Section>

  <!-- 09 · Scenarios by sector -->
  <Section id="proyectos" tone="tint" title="Escenarios por sector" lead="Profesionales que ya hablan con futuros clientes de MIRADEX.">
    <FeatureGrid items={sectors} cols={4} />
    <div class="gap-top"><Gallery items={gallery} /></div>
  </Section>

  <CtaBand title="Usted recomienda. Nosotros vendemos." text="Usted recibe la recompensa." tone="mint" scenario="recomendar" cta="Hacerme socio" />

  <!-- 10 · FAQ -->
  <Section id="faq" title="Preguntas frecuentes">
    <Faq items={faq} />
  </Section>

  <!-- 11 · Final CTA + form -->
  <FinalForm
    title="Hágase socio de MIRADEX"
    text="Reciba su enlace o código QR personal, recomiende MIRADEX y reciba una recompensa por las ventas realizadas."
    scenario="recomendar"
    points={finalPoints}
  />
</Page>

<style>
  .gap-top { margin-top: var(--stack-gap); }
</style>
