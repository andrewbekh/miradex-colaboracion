---
// Landing 03 · "Quiero comprar para proyectos" (project sales: builders, developers). Sources: strategy 3.3
// (a separate Project Sales channel), 6.1; video scripts nº6 and nº7.
import Page from '../../layouts/Page.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import VideoPlaceholder from '../../components/VideoPlaceholder.astro';
import WhyMiradex from '../../components/WhyMiradex.astro';
import CtaBand from '../../components/CtaBand.astro';
import ScenarioLinks from '../../components/ScenarioLinks.astro';
import Economics from '../../components/Economics.astro';
import SupportGroups from '../../components/SupportGroups.astro';
import Responsibilities from '../../components/Responsibilities.astro';
import Stats from '../../components/Stats.astro';
import CategoryCards from '../../components/CategoryCards.astro';
import FitList from '../../components/FitList.astro';
import Steps from '../../components/Steps.astro';
import Gallery from '../../components/Gallery.astro';
import Faq from '../../components/Faq.astro';
import FinalForm from '../../components/FinalForm.astro';
import { scenarioById } from '../../data/scenarios';
import { productStats, statsFootnote, faq as commonFaq, finalPoints } from '../../data/shared';

const s = scenarioById('proyectos')!;

const drivers = [
  { icon: 'coins', title: 'Precio de fábrica', text: 'Condiciones especiales según el volumen y las características del proyecto.' },
  { icon: 'clock', title: 'Plazos claros', text: 'Producción en 3-5 días laborables y entrega en España en 5-10.' },
  { icon: 'ruler', title: 'A medida del proyecto', text: 'No adapta la obra a medidas estándar: fabricamos según sus parámetros.' },
  { icon: 'calendar-days', title: 'Entregas por fases', text: 'Producción y entregas según el calendario real de la obra.' },
  { icon: 'layers', title: 'Un concepto único', text: 'Valla, puertas y fachada en el mismo modelo y color en todas las fases.' },
  { icon: 'shield-check', title: 'Garantía', text: 'Hasta 30 años de garantía técnica y 15 de estética, según acabado.' },
];

const process = [
  { icon: 'pencil-ruler', title: 'Desde el proyecto', text: 'Nos sumamos en la fase de proyecto y elección de materiales.' },
  { icon: 'file-text', title: 'Usted envía datos', text: 'Medidas, especificación, pliego o concepto del proyecto.' },
  { icon: 'calculator', title: 'Selección y cálculo', text: 'Elegimos modelos y acabados y calculamos cantidades.' },
  { icon: 'clipboard-check', title: 'Propuesta', text: 'Producto, volumen, precio y calendario de entregas.' },
];

const sources = [
  { title: 'Volumen total', text: 'Cuanto mayor es el volumen, mejores son las condiciones.' },
  { title: 'Fases y calendario', text: 'La planificación por fases permite producir y entregar a tiempo.' },
  { title: 'Modelos y acabados', text: 'La solución elegida para la arquitectura del proyecto.' },
  { title: 'Proyectos repetidos', text: 'Condiciones a largo plazo para series de obras y compras regulares.' },
];

const support = [
  { icon: 'pencil-ruler', title: 'Proyecto', items: ['Selección de modelos y acabados', 'Cálculo de cantidades', 'Propuesta según especificación'] },
  { icon: 'factory', title: 'Producción', items: ['Fabricación a medida', 'Grandes volúmenes', 'Producción por fases'] },
  { icon: 'truck', title: 'Logística', items: ['Entregas según el calendario de obra', 'Entrega a cualquier punto de España', 'Plazos claros por fase'] },
  { icon: 'wrench', title: 'Instalación', items: ['Red local de instaladores verificados', 'Documentación técnica', 'Instrucciones de montaje'] },
];

const steps = [
  { title: 'Proyecto', text: 'Nos envía medidas, especificación o pliego.' },
  { title: 'Cálculo', text: 'Elegimos la solución y calculamos cantidades.' },
  { title: 'Propuesta', text: 'Precio, volumen y calendario de entregas.' },
  { title: 'Producción', text: 'A medida, por fases si hace falta.' },
  { title: 'Entrega', text: 'En la obra, según el calendario.' },
  { title: 'Siguientes fases', text: 'Mismo modelo y condiciones para nuevas fases y proyectos.' },
];

const sectors = [
  { icon: 'house', title: 'Constructora: obra individual', text: 'Viviendas unifamiliares y obras comerciales con plazos ajustados.' },
  { icon: 'building', title: 'Promotora: urbanización por fases', text: 'Decenas o cientos de viviendas con el mismo concepto en cada fase.' },
  { icon: 'hotel', title: 'Hoteles y proyectos comerciales', text: 'Cerramiento y fachada en un mismo estilo para todo el complejo.' },
  { icon: 'repeat', title: 'Compras recurrentes', text: 'Condiciones a largo plazo para empresas con obras regulares.' },
];
const gallery = [
  { src: '/img/photos/atlas-villas.jpg', caption: 'Atlas · Gris grafito RAL 7024' },
  { src: '/img/photos/jupiter-facade-black.jpg', caption: 'Fachada Jupiter · RAL 9005' },
  { src: '/img/photos/romb-mini-street.jpg', caption: 'Romb Mini · RAL 7016' },
  { src: '/img/photos/atlas-mountain.jpg', caption: 'Atlas · Antracita RAL 7016' },
];

const faq = [
  { q: '¿Pueden participar en la fase de proyecto?', a: '<p>Sí. Podemos sumarnos en la fase de proyecto y elección de materiales.</p>' },
  { q: '¿Qué necesitan para preparar la propuesta?', a: '<p>Medidas, especificación, pliego o concepto del proyecto. Con eso elegimos modelos y acabados, calculamos cantidades y preparamos la propuesta.</p>' },
  { q: '¿Pueden entregar por fases?', a: '<p>Sí. Producimos para cada fase y entregamos según los plazos acordados con su obra.</p>' },
  { q: '¿Cómo se calcula el precio para grandes volúmenes?', a: '<p>Según el volumen total, las fases y los modelos y acabados elegidos. Para proyectos repetidos ofrecemos condiciones a largo plazo.</p>' },
  { q: '¿Se mantiene el mismo modelo en futuras fases?', a: '<p>Sí. Los modelos, medidas y acabados acordados se mantienen para conservar el concepto arquitectónico en las siguientes fases.</p>' },
  { q: '¿Quién instala?', a: '<p>Puede usar su propio equipo o la red local de instaladores verificados de MIRADEX.</p>' },
  commonFaq.leadTimes,
  commonFaq.warranty,
];
---
<Page
  title="Vallas metálicas para proyectos y promociones · MIRADEX"
  description="Precio de fábrica según volumen, producción a medida y entregas por fases para constructoras, promotoras y grandes obras en toda España."
  scenario="proyectos"
  current="proyectos"
>
  <!-- 01 · First screen -->
  <Hero
    crumb={{ num: s.num, label: s.short, tone: s.tone }}
    eyebrow="Para constructoras, promotoras y grandes obras"
    title="Precio, plazos y volumen para sus proyectos"
    lead="Vallas, puertas y fachada directamente del fabricante europeo: condiciones especiales según el volumen, producción a medida y entregas según el calendario de su obra."
    scenario="proyectos"
    cta="Enviar proyecto"
    image={s.image}
    imageAlt="Viviendas con vallas metálicas Atlas"
    note="Le respondemos en 24 horas. Envíenos medidas, especificación o pliego."
  />

  <!-- 02 · Why it pays off -->
  <Section id="por-que" tone="tint" title="Por qué MIRADEX para su obra" lead="Lo que más pesa al elegir materiales: precio, plazos y una solución para el proyecto.">
    <FeatureGrid items={drivers} />
  </Section>

  <!-- 03 · Videos nº6 and nº7 -->
  <Section id="video" title="Para constructoras y para promotoras" lead="Dos vídeos de 3 minutos: obras y proyectos de construcción, y grandes proyectos residenciales por fases.">
    <div class="videos">
      <VideoPlaceholder num={6} title="Miradex para constructoras y promotoras" duration="3:00-3:15" poster="/img/photos/romb-pro-house.jpg" />
      <VideoPlaceholder num={7} title="Miradex para proyectos residenciales" duration="3:00-3:20" poster="/img/photos/atlas-mountain.jpg" />
    </div>
  </Section>

  <WhyMiradex />

  <CtaBand title="¿Tiene una obra en marcha?" text="Envíenos el proyecto o la especificación. Le respondemos en 24 horas." scenario="proyectos" cta="Enviar proyecto" />

  <!-- 04 · How we work with your project -->
  <Section id="como-funciona" title="Cómo trabajamos con su proyecto" lead="Es un canal de ventas para proyectos, distinto del programa de distribuidores.">
    <FeatureGrid items={process} cols={4} />
    <div class="gap-top"><ScenarioLinks ids={['instalar', 'vender']} title="¿Instala o revende vallas?" /></div>
  </Section>

  <!-- 05 · Economics -->
  <Section id="economia" tone="tint" title="Precio para su proyecto" lead="El precio se calcula para cada proyecto: volumen, fases y solución elegida.">
    <Economics
      sources={sources}
      sourcesLabel="Qué define su precio"
      principle="Precio de fabricante, calculado sobre el volumen y las fases del proyecto."
      model={{ title: 'Propuesta para su presupuesto', text: 'Calculamos la propuesta para que pueda incluir el coste en la economía del proyecto desde el principio.' }}
    />
  </Section>

  <!-- 06 · What you receive -->
  <Section id="apoyo" title="Qué recibe" lead="Apoyo técnico, producción y logística en cada fase.">
    <SupportGroups groups={support} />
  </Section>

  <Section id="funciones" tone="tint" title="Cómo nos repartimos el trabajo" lead="Usted nos da los datos del proyecto. MIRADEX calcula, produce y entrega.">
    <Responsibilities
      miradex={[
        'Cálculo y propuesta para el proyecto',
        'Producción a medida, también por fases',
        'Entregas según el calendario de la obra',
        'Soporte técnico y documentación',
        'Garantía según acabado',
      ]}
      partnerTitle="Su empresa aporta"
      partner={[
        'Medidas, especificación o pliego',
        'Calendario de la obra',
        'Confirmación de pedidos por fase',
      ]}
    />
  </Section>

  <CtaBand title="Hablemos de su próxima fase" text="Formulario o WhatsApp: como le resulte más cómodo." tone="dark" scenario="proyectos" cta="Enviar proyecto" />

  <!-- 07 · Value for the project -->
  <Section id="producto" title="Valor para su proyecto" lead="Un acabado moderno y uniforme para casas, calles y zonas comunes.">
    <Stats stats={productStats} footnote={statsFootnote} />
    <div class="gap-top"><CategoryCards /></div>
  </Section>

  <Section id="para-quien" tone="tint" title="¿Es para usted?">
    <FitList
      fit={[
        'Construye viviendas, promociones, hoteles u obras comerciales.',
        'Necesita volumen y plazos fiables.',
        'Quiere un mismo concepto en varias fases.',
        'Compra para sus propias obras.',
      ]}
      notFit={[
        'Quiere revender el producto: vea «Vender MIRADEX».',
        'Es un cliente particular con una sola vivienda: vea el catálogo.',
      ]}
    />
  </Section>

  <!-- 08 · How it starts -->
  <Section id="inicio" title="Cómo empieza la colaboración">
    <Steps steps={steps} />
  </Section>

  <!-- 09 · Scenarios -->
  <Section id="proyectos" tone="tint" title="Proyectos y escenarios" lead="Obras individuales, promociones por fases y compras regulares.">
    <FeatureGrid items={sectors} cols={4} />
    <div class="gap-top"><Gallery items={gallery} /></div>
  </Section>

  <CtaBand title="Un socio de producción para sus proyectos" text="Precio competitivo, producción rápida y colaboración a largo plazo." tone="mint" scenario="proyectos" cta="Enviar proyecto" />

  <!-- 10 · FAQ -->
  <Section id="faq" title="Preguntas frecuentes">
    <Faq items={faq} />
  </Section>

  <!-- 11 · Final CTA + form -->
  <FinalForm
    title="Envíenos su proyecto"
    text="Con el proyecto, la especificación o los datos principales prepararemos una propuesta con el producto, el volumen y las condiciones de entrega."
    scenario="proyectos"
    points={finalPoints}
  />
</Page>

<style>
  .gap-top { margin-top: var(--stack-gap); }
  .videos { display: grid; grid-template-columns: 1fr 1fr; gap: var(--grid-gap); }
  @media (max-width: 1199px) { .videos { grid-template-columns: 1fr; } }
</style>
