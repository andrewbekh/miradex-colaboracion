---
// Landing 02 · "Quiero vender e instalar" (installation partner). Sources: strategy 3.2, 11 (installation network),
// pricing model (installer role, no numbers); video script nº3 (Spanish version).
import Page from '../../layouts/Page.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import VideoPlaceholder from '../../components/VideoPlaceholder.astro';
import WhyMiradex from '../../components/WhyMiradex.astro';
import CtaBand from '../../components/CtaBand.astro';
import ScenarioLinks from '../../components/ScenarioLinks.astro';
import Economics from '../../components/Economics.astro';
import SupportGroups from '../../components/SupportGroups.astro';
import Responsibilities from '../../components/Responsibilities.astro';
import Stats from '../../components/Stats.astro';
import CategoryCards from '../../components/CategoryCards.astro';
import FitList from '../../components/FitList.astro';
import Steps from '../../components/Steps.astro';
import Gallery from '../../components/Gallery.astro';
import Faq from '../../components/Faq.astro';
import FinalForm from '../../components/FinalForm.astro';
import { scenarioById } from '../../data/scenarios';
import { productStats, statsFootnote, faq as commonFaq, finalPoints } from '../../data/shared';

const s = scenarioById('instalar')!;

const drivers = [
  { icon: 'coins', title: 'Dos ingresos por obra', text: 'Margen en el producto y su propio ingreso por la instalación.' },
  { icon: 'timer', title: 'Montaje rápido', text: 'Con la base preparada, dos instaladores montan una sección en unos 20 minutos.' },
  { icon: 'map-pin', title: 'Pedidos en su zona', text: 'Tras la formación, recibe pedidos de instalación de MIRADEX en su zona.' },
  { icon: 'hard-hat', title: 'Sin ser especialista', text: 'Si tiene experiencia en construcción o instalación, puede trabajar con MIRADEX.' },
  { icon: 'calendar-check', title: 'Más obras, mismo equipo', text: 'Montaje rápido y entrega ágil: termina antes y acepta más proyectos.' },
  { icon: 'map', title: 'Venta en toda España', text: 'La venta no tiene límite de zona. La zona solo importa para la instalación.' },
];

const ways = [
  { icon: 'user', title: 'Su propio cliente', text: 'Usted vende e instala: margen en el producto y su instalación.' },
  { icon: 'handshake', title: 'Pasa el cliente a MIRADEX', text: 'Nosotros hacemos la consulta, el presupuesto y el pedido. Usted recibe una comisión y puede hacer la instalación.' },
  { icon: 'map-pin', title: 'Pedido de MIRADEX', text: 'Recibe pedidos locales de instalación de clientes de MIRADEX en su zona.' },
];

const sources = [
  { title: 'Margen en el producto', text: 'Compra a precio de socio y vende a su cliente.' },
  { title: 'Ingreso por instalación', text: 'Su trabajo de montaje, aparte del producto.' },
  { title: 'Comisión por cliente pasado', text: 'Cuando MIRADEX vende al cliente que usted trae.' },
  { title: 'Pedidos de instalación', text: 'Obras de clientes de MIRADEX en su zona.' },
];
const factors = ['Volumen de ventas', 'Zona y radio de trabajo', 'Tamaño del equipo', 'Capacidad de montaje', 'Formación', 'Rapidez de respuesta', 'Calidad del montaje'];

const support = [
  { icon: 'graduation-cap', title: 'Formación', items: ['Sistema de montaje', 'Instrucciones y vídeos', 'Formación antes del primer pedido'] },
  { icon: 'file-text', title: 'Técnica', items: ['Documentación técnica', 'Apoyo técnico en los primeros proyectos', 'Ayuda con los cálculos'] },
  { icon: 'map-pin', title: 'Pedidos', items: ['Pedidos locales de instalación', 'Clientes de MIRADEX en su zona', 'Registro de sus clientes y proyectos'] },
  { icon: 'handshake', title: 'Comercial', items: ['Precio de socio', 'Fotos, catálogos y muestras', 'Presupuesto y venta por MIRADEX cuando lo necesite'] },
];

const steps = [
  { title: 'Solicitud', text: 'Nos cuenta sobre su empresa o equipo.' },
  { title: 'Cualificación', text: 'Zona de trabajo, radio, tamaño del equipo y capacidad.' },
  { title: 'Formación', text: 'Sistema de montaje, instrucciones y vídeos.' },
  { title: 'Primeros proyectos', text: 'Apoyo técnico en las primeras obras.' },
  { title: 'Red de instaladores', text: 'Empieza a recibir pedidos en su zona.' },
  { title: 'Trabajo regular', text: 'Venta propia, clientes pasados y pedidos de MIRADEX.' },
];

const sectors = [
  { icon: 'wrench', title: 'Empresas de instalación', text: 'Producto, montaje y pedidos locales de MIRADEX.' },
  { icon: 'hammer', title: 'Metalistería', text: 'Menos fabricación manual, más obras y montaje.' },
  { icon: 'hard-hat', title: 'Contratistas y reformas', text: 'Amplíe sus servicios en las obras de sus clientes.' },
  { icon: 'door-open', title: 'Puertas y automatismos', text: 'Instale todo el perímetro: puerta, valla y fachada.' },
];
const gallery = [
  { src: '/img/photos/tisa-wood-stone.jpg', caption: 'Tisa · Nogal oscuro' },
  { src: '/img/photos/atlas-wood-house.jpg', caption: 'Atlas · Nogal oscuro' },
  { src: '/img/photos/piramida-garden.jpg', caption: 'Piramida · Gris grafito RAL 7024' },
  { src: '/img/photos/terra-wood.jpg', caption: 'Terra · Roble dorado' },
];

const faq = [
  { q: '¿Necesito ser especialista en vallas?', a: '<p>No. Si tiene experiencia en construcción o instalación y puede instalar nuestros productos en las obras de sus clientes, puede trabajar con MIRADEX.</p>' },
  { q: '¿Cuánto se tarda en montar?', a: '<p>El sistema está pensado para montarse en obra. Con la base preparada, dos instaladores montan una sección de cerramiento en unos 20 minutos.</p>' },
  { q: '¿Cómo recibo pedidos de MIRADEX?', a: '<p>Después de la formación, los socios reciben pedidos de instalación de MIRADEX en su zona. Se reparten por zona, carga de trabajo, competencia, calidad y rapidez.</p>' },
  { q: '¿Tengo exclusividad en mi zona?', a: '<p>No hay exclusividad permanente de instalación. Los pedidos se asignan por calidad, rapidez y capacidad. La venta no tiene límite de zona.</p>' },
  { q: '¿Qué gano si paso el cliente a MIRADEX?', a: '<p>Una comisión por la venta. Además, puede hacer la instalación y ganar con ella.</p>' },
  { q: '¿Cómo mejoro mis condiciones?', a: '<p>Con su volumen real de ventas. No necesita cambiar de formato, crear una web ni abrir un showroom.</p>' },
  commonFaq.leadTimes,
  commonFaq.warranty,
  commonFaq.protection,
];
---
<Page
  title="Venda e instale MIRADEX · Colaboración para instaladores"
  description="Gane con la venta y la instalación de vallas metálicas MIRADEX y reciba pedidos de instalación en su zona. Formación, documentación y apoyo técnico."
  scenario="instalar"
  current="instalar"
>
  <!-- 01 · First screen -->
  <Hero
    crumb={{ num: s.num, label: s.short }}
    eyebrow="Para instaladores, contratistas y metalistería"
    title="Gane con el producto y con la instalación"
    lead="Usted ya trabaja en las obras de sus clientes. MIRADEX le ofrece el producto, el apoyo y nuevos pedidos de instalación en su zona."
    scenario="instalar"
    image={s.image}
    imageAlt="Valla metálica Atlas instalada en una calle"
    note="Le respondemos en 24 horas. No necesita ser especialista en vallas."
  />

  <!-- 02 · Why it pays off -->
  <Section id="por-que" tone="tint" title="Por qué es rentable para su empresa" lead="Dos ingresos en cada obra y más pedidos con el mismo equipo.">
    <FeatureGrid items={drivers} />
  </Section>

  <!-- 03 · Video nº3 -->
  <Section id="video" title="Más trabajo en 3 minutos" lead="Producto, montaje fácil y rápido, formas de ganar, pedidos de MIRADEX y apoyo.">
    <VideoPlaceholder num={s.video.num} title={s.video.title} duration={s.video.duration} poster="/img/photos/tisa-wood-stone.jpg" />
  </Section>

  <WhyMiradex />

  <CtaBand title="¿Quiere recibir pedidos en su zona?" text="Cuéntenos sobre su empresa o equipo. Le respondemos en 24 horas." scenario="instalar" />

  <!-- 04 · How to work with MIRADEX -->
  <Section id="como-funciona" title="Tres formas de ganar con MIRADEX" lead="Combínelas según su carga de trabajo.">
    <FeatureGrid items={ways} />
    <div class="gap-top"><ScenarioLinks ids={['vender', 'recomendar', 'negocio']} /></div>
  </Section>

  <!-- 05 · Economics -->
  <Section id="economia" tone="tint" title="Economía de la colaboración" lead="Su función no limita sus condiciones: si vende más, mejora su nivel sin cambiar de formato.">
    <Economics
      sources={sources}
      factors={factors}
      factorsLabel="Qué tenemos en cuenta en la red de instaladores"
      principle="En una obra grande recibe la misma condición especial que cualquier socio con un pedido del mismo tamaño."
      model={{ title: 'Su nivel crece con sus ventas', text: 'El nivel de socio se revisa por el volumen real de ventas. No necesita web ni showroom para mejorarlo.' }}
    />
  </Section>

  <!-- 06 · What the partner receives -->
  <Section id="apoyo" title="Qué recibe como socio" lead="Formación, soporte técnico y pedidos para que instale con seguridad.">
    <SupportGroups groups={support} />
  </Section>

  <Section id="funciones" tone="tint" title="Qué asume cada parte" lead="Usted se encarga de la obra. MIRADEX produce, entrega y le da soporte.">
    <Responsibilities
      miradex={[
        'Producción a medida y control de calidad',
        'Entrega en España en 5-10 días laborables',
        'Documentación, instrucciones y formación',
        'Consulta, presupuesto y pedido cuando usted pasa el cliente',
        'Garantía del producto según acabado',
      ]}
      partner={[
        'Medición correcta en la obra',
        'Datos técnicos exactos para el pedido',
        'Instalación de calidad',
        'Respuesta rápida en su zona',
      ]}
      note="Los pedidos de instalación se reparten por zona, carga de trabajo, competencia, calidad y rapidez."
    />
  </Section>

  <CtaBand title="Hablemos de su equipo" text="Formulario o WhatsApp: como le resulte más cómodo." tone="dark" scenario="instalar" />

  <!-- 07 · Why their clients want MIRADEX -->
  <Section id="producto" title="Por qué sus clientes elegirán MIRADEX" lead="Producto fabricado a medida y pensado para montarse en obra.">
    <Stats stats={productStats} footnote={statsFootnote} />
    <div class="gap-top"><CategoryCards /></div>
  </Section>

  <Section id="para-quien" tone="tint" title="¿Es para usted?">
    <FitList
      fit={[
        'Trabaja en construcción, reformas o instalación.',
        'Tiene equipo propio o trabaja con instaladores.',
        'Quiere más pedidos sin buscar más clientes.',
        'Puede garantizar calidad y respuesta rápida en su zona.',
      ]}
      notFit={[
        'No tiene experiencia en construcción ni instalación.',
        'Busca exclusividad de instalación en una zona: los pedidos se reparten por calidad y rapidez.',
        'Solo quiere vender, sin instalar: vea «Vender MIRADEX».',
      ]}
    />
  </Section>

  <!-- 08 · How it starts -->
  <Section id="inicio" title="Cómo empieza la colaboración">
    <Steps steps={steps} />
  </Section>

  <!-- 09 · Scenarios by sector -->
  <Section id="proyectos" tone="tint" title="Escenarios por sector" lead="Cómo encaja MIRADEX en empresas como la suya.">
    <FeatureGrid items={sectors} cols={4} />
    <div class="gap-top"><Gallery items={gallery} /></div>
  </Section>

  <CtaBand title="Usted ya trabaja en las obras de sus clientes" text="MIRADEX le ofrece el producto, el apoyo y nuevas oportunidades para ganar más." tone="mint" scenario="instalar" />

  <!-- 10 · FAQ -->
  <Section id="faq" title="Preguntas frecuentes">
    <Faq items={faq} />
  </Section>

  <!-- 11 · Final CTA + form -->
  <FinalForm
    title="Cuéntenos sobre su empresa o equipo"
    text="Si tiene experiencia en construcción o instalación y quiere nuevos pedidos e ingresos adicionales, empecemos."
    scenario="instalar"
    points={finalPoints}
  />
</Page>

<style>
  .gap-top { margin-top: var(--stack-gap); }
</style>
