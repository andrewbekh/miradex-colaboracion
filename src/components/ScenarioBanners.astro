---
// The choice of format as big photo banners, two per row (5 formats + "not sure" = 3 rows).
// Every banner opens a full landing, so the whole surface is the link.
// Hover: the photo zooms in slightly and the arrow turns inside its button. Nothing else moves.
import { ui } from '../data/ui';
import Icon from './Icon.astro';
import { scenarios, toneStyle } from '../data/scenarios';
---
<ul class="bn-grid" role="list">
  {scenarios.map((s) => (
    <li>
      <a class="bn" href={s.href}>
        <img class="bn__img" src={s.image} alt="" loading="lazy" />
        <span class="bn__shade" aria-hidden="true"></span>
        <span class="bn__num" style={toneStyle(s.tone)}>{s.num}</span>
        <span class="bn__go" aria-hidden="true"><Icon name="arrow-up-right" size={22} /></span>
        <span class="bn__body">
          <span class="bn__title">{s.title}</span>
          <span class="bn__text">{s.promise}</span>
          <span class="bn__for">
            <span class="bn__for-label">{ui.videosRow.forWhom}</span>
            <span class="bn__tags">{s.audience.map((a) => <span class="bn__tag">{a}</span>)}</span>
          </span>
        </span>
      </a>
    </li>
  ))}
  <li>
    <div class="bn bn--ask">
      <span class="bn__body">
        <span class="bn__title">{ui.ask.title}</span>
        <span class="bn__text">{ui.ask.text}</span>
        <button type="button" class="btn btn--primary bn__cta" data-open-form data-scenario="no-se"><span>{ui.cta.apply}</span><Icon name="arrow-right" size={18} /></button>
      </span>
    </div>
  </li>
</ul>

<style>
  .bn-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--grid-gap); }
  .bn-grid > li { display: flex; }
  .bn {
    position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; width: 100%; min-height: clamp(360px, 30vw, 460px);
    border-radius: var(--radius-lg); color: var(--c-white); text-decoration: none; background: var(--c-grey);
  }
  .bn__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 600ms var(--ease); }
  .bn__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(53 53 53 / 0.9) 0%, rgb(53 53 53 / 0.6) 48%, rgb(53 53 53 / 0.08) 100%); }
  .bn__num {
    position: absolute; top: 20px; left: 20px; display: grid; place-items: center; min-width: 44px; height: 44px; padding: 0 10px;
    border-radius: var(--radius-sm); font-weight: var(--fw-medium); font-size: var(--fs-small);
  }
  .bn__go {
    position: absolute; top: 20px; right: 20px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-sm);
    background: var(--c-white); color: var(--c-ink);
  }
  .bn__go :global(svg) { transition: transform var(--dur) var(--ease); }
  .bn__body { display: grid; gap: var(--sp-3); padding: var(--sp-7); max-width: 660px; }
  .bn__title { font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem); font-weight: var(--fw-medium); line-height: 1.08; text-transform: uppercase; letter-spacing: var(--tracking-caps); text-wrap: balance; }
  .bn__text { font-size: var(--fs-body); color: rgb(255 255 255 / 0.9); max-width: 46ch; }
  .bn__for { display: grid; gap: 10px; margin-top: var(--sp-3); padding-top: var(--sp-4); border-top: 1px solid rgb(255 255 255 / 0.3); }
  .bn__for-label { font-size: var(--fs-micro); font-weight: var(--fw-medium); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-mint); }
  .bn__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .bn__tag { padding: 7px 12px; border-radius: var(--radius-xs); background: var(--c-white); color: var(--c-ink); font-size: var(--fs-small); font-weight: var(--fw-medium); line-height: 1.2; }
  a.bn:hover .bn__img { transform: scale(1.04); }
  a.bn:hover .bn__go :global(svg) { transform: rotate(45deg); }

  .bn--ask { background: var(--c-mint); color: var(--c-ink); }
  .bn--ask .bn__text { color: var(--c-ink); opacity: 0.85; }
  .bn__cta { justify-self: start; margin-top: var(--sp-2); }

  @media (max-width: 1199px) {
    .bn-grid { grid-template-columns: 1fr; }
    .bn { min-height: 340px; }
    .bn__body { padding: var(--sp-6); }
  }
  @media (max-width: 767px) {
    .bn-grid { gap: 12px; }
    .bn { min-height: 360px; border-radius: var(--radius-md); }
    .bn__num { top: 16px; left: 16px; }
    .bn__go { top: 16px; right: 16px; width: 40px; height: 40px; }
    .bn__body { padding: var(--sp-5); }
    .bn__tag { font-size: var(--fs-micro); padding: 6px 10px; }
    .bn__cta { width: 100%; }
  }
</style>
