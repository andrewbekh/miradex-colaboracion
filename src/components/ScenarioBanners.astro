---
// The choice of format as big photo banners, two per row (5 formats + "not sure" = 3 rows).
// Every banner opens a full landing, so the whole surface is the link.
import Pattern from './Pattern.astro';
import Icon from './Icon.astro';
import { scenarios, toneStyle } from '../data/scenarios';
---
<ul class="bn-grid" role="list">
  {scenarios.map((s) => (
    <li>
      <a class="bn" href={s.href}>
        <img class="bn__img" src={s.image} alt="" loading="lazy" />
        <span class="bn__shade" aria-hidden="true"></span>
        <span class="bn__bands" aria-hidden="true"><Pattern seed={`card-${s.id}`} cols={2} units={20} fill gaps={false} /></span>
        <span class="bn__num" style={toneStyle(s.tone)}>{s.num}</span>
        <span class="bn__go" aria-hidden="true"><Icon name="arrow-up-right" size={22} /></span>
        <span class="bn__body">
          <span class="bn__title">{s.title}</span>
          <span class="bn__text">{s.promise}</span>
          <span class="bn__for">{s.audience.map((a) => <span class="bn__tag">{a}</span>)}</span>
        </span>
      </a>
    </li>
  ))}
  <li>
    <div class="bn bn--ask">
      <span class="bn__body">
        <span class="bn__title">¿No sabe qué formato elegir?</span>
        <span class="bn__text">Cuéntenos sobre su negocio y sus planes: le propondremos el formato y las condiciones según su potencial. Una empresa puede combinar varios formatos.</span>
        <button type="button" class="btn btn--primary bn__cta" data-open-form data-scenario="no-se"><span>Le ayudamos a elegir</span><Icon name="arrow-right" size={18} /></button>
      </span>
    </div>
  </li>
</ul>

<style>
  .bn-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--grid-gap); }
  .bn-grid > li { display: flex; }
  .bn {
    position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; width: 100%; min-height: clamp(320px, 26vw, 420px);
    border-radius: var(--radius-lg); color: var(--c-white); text-decoration: none; background: var(--c-ink);
  }
  .bn__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 700ms var(--ease); }
  .bn__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(53 53 53 / 0.92) 0%, rgb(53 53 53 / 0.55) 50%, rgb(53 53 53 / 0.12) 100%); }
  .bn__bands { position: absolute; top: 0; right: 0; bottom: 0; width: 8px; z-index: -1; transition: width 320ms var(--ease); }
  .bn__num {
    position: absolute; top: 20px; left: 20px; display: grid; place-items: center; min-width: 44px; height: 44px; padding: 0 10px;
    border-radius: var(--radius-sm); font-weight: var(--fw-medium); font-size: var(--fs-small);
  }
  .bn__go {
    position: absolute; top: 20px; right: 28px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-sm);
    background: var(--c-white); color: var(--c-ink); transition: transform var(--dur) var(--ease), right 320ms var(--ease);
  }
  .bn__body { display: grid; gap: var(--sp-3); padding: var(--sp-7) calc(8px + var(--sp-7)) var(--sp-7) var(--sp-7); max-width: 640px; }
  .bn__title { font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem); font-weight: var(--fw-medium); line-height: 1.08; text-transform: uppercase; letter-spacing: var(--tracking-caps); text-wrap: balance; }
  .bn__text { font-size: var(--fs-body); color: rgb(255 255 255 / 0.85); max-width: 46ch; }
  .bn__for { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--sp-2); }
  .bn__tag { padding: 5px 10px; border-radius: var(--radius-xs); background: rgb(255 255 255 / 0.16); backdrop-filter: blur(6px); font-size: var(--fs-micro); color: var(--c-white); }
  a.bn:hover .bn__img { transform: scale(1.05); }
  a.bn:hover .bn__bands { width: 64px; }
  a.bn:hover .bn__go { right: 84px; transform: rotate(45deg); }

  .bn--ask { background: var(--c-mint); color: var(--c-ink); }
  .bn--ask .bn__body { padding-right: var(--sp-7); }
  .bn--ask .bn__text { color: var(--c-ink); opacity: 0.8; }
  .bn__cta { justify-self: start; margin-top: var(--sp-2); }

  @media (max-width: 1199px) {
    .bn-grid { grid-template-columns: 1fr; }
    .bn { min-height: 300px; }
    .bn__body { padding: var(--sp-6) calc(8px + var(--sp-5)) var(--sp-6) var(--sp-6); }
  }
  @media (max-width: 767px) {
    .bn-grid { grid-template-columns: 1fr; gap: 12px; }
    .bn { min-height: 280px; border-radius: var(--radius-md); }
    .bn__bands { width: 6px; }
    .bn__num { top: 16px; left: 16px; }
    .bn__go { top: 16px; right: 22px; width: 40px; height: 40px; }
    .bn__body { padding: var(--sp-5) calc(6px + var(--sp-5)) var(--sp-5) var(--sp-5); }
    .bn__tag { font-size: 12px; }
    .bn--ask .bn__body { padding-right: var(--sp-5); }
    .bn__cta { width: 100%; }
  }
</style>
