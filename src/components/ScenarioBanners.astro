---
// The five formats as banners on a grey section, two per row: one half is the text on white, the other half the photo.
// Every banner opens a full landing, so the whole surface is the link.
// Hover: the photo zooms in slightly and the arrow turns inside its button. Nothing else moves.
// Text sits at the top of its half and the photo fills the rest, so unequal texts never stretch the layout.
import { ui } from '../data/ui';
import Icon from './Icon.astro';
import { scenarios, toneStyle } from '../data/scenarios';
---
<ul class="bn-grid" role="list">
  {scenarios.map((s) => (
    <li class:list={{ 'bn-wide': !!s.includes }}>
      <a class:list={['bn', { 'bn--wide': !!s.includes }]} href={s.href}>
        <span class="bn__body">
          <span class="bn__num" style={toneStyle(s.tone)}>{s.num}</span>
          <span class="bn__title">{s.title}</span>
          <span class="bn__text">{s.promise}</span>
          <span class="bn__lists">
            <span class="bn__for">
              <span class="bn__for-label">{ui.videosRow.forWhom}</span>
              <span class="bn__list">{s.audience.map((a) => <span class="bn__li">{a}</span>)}</span>
            </span>
            {s.includes && (
              <span class="bn__for">
                <span class="bn__for-label">{ui.banners.builds}</span>
                <span class="bn__list">{s.includes.map((a) => <span class="bn__li">{a}</span>)}</span>
              </span>
            )}
          </span>
        </span>
        <span class="bn__media" aria-hidden="true">
          <img class="bn__img" src={s.image} alt="" loading="lazy" />
          <span class="bn__go"><Icon name="arrow-up-right" size={22} /></span>
        </span>
      </a>
    </li>
  ))}
  <li class="bn-wide">
    <div class="bn bn--ask">
      <span class="bn__body">
        <span class="bn__num bn__num--ask" aria-hidden="true">?</span>
        <span class="bn__title">{ui.ask.title}</span>
        <span class="bn__text">{ui.ask.text}</span>
        <button type="button" class="btn btn--primary bn__cta" data-open-form data-scenario="no-se"><span>{ui.cta.apply}</span><Icon name="arrow-right" size={18} /></button>
      </span>
    </div>
  </li>
</ul>

<style>
  .bn-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); }
  .bn-grid > li { display: flex; }
  /* Business MIRADEX is the priority format: full row, with what the partner builds */
  .bn-grid > li.bn-wide { grid-column: 1 / -1; }
  .bn__lists { display: grid; gap: var(--sp-4); align-items: start; }
  .bn__for, .bn__list { align-content: start; }
  .bn--wide .bn__lists { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-6); }
  .bn--wide .bn__text { font-size: var(--fs-body); max-width: 52ch; }
  .bn {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; min-height: clamp(380px, 30vw, 440px); overflow: hidden;
    border-radius: var(--radius-lg); background: var(--c-white); color: var(--c-ink); text-decoration: none;
  }
  .bn__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-3); padding: var(--sp-6); min-width: 0; }
  .bn__num { display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 8px; margin-bottom: var(--sp-2); border-radius: var(--radius-sm); font-weight: var(--fw-medium); font-size: var(--fs-small); }
  .bn__title { font-size: clamp(1.25rem, 1rem + 0.6vw, 1.625rem); font-weight: var(--fw-medium); line-height: 1.12; text-transform: uppercase; letter-spacing: var(--tracking-caps); text-wrap: balance; }
  .bn__text { font-size: var(--fs-small); color: var(--text-muted); }
  .bn__for { display: grid; gap: 8px; margin-top: var(--sp-2); }
  .bn__for-label { font-size: var(--fs-micro); font-weight: var(--fw-medium); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted); }
  .bn__list { display: grid; gap: 6px; }
  .bn__li { position: relative; padding-left: 16px; font-size: var(--fs-small); font-weight: var(--fw-medium); line-height: 1.35; }
  .bn__li::before { content: '•'; position: absolute; left: 2px; top: 0; color: var(--c-blue); }

  .bn__media { position: relative; overflow: hidden; background: var(--c-grey); }
  .bn__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .bn__go { position: absolute; top: 16px; right: 16px; display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--c-white); color: var(--c-ink); }
  .bn__go :global(svg) { transition: transform var(--dur) var(--ease); }
  a.bn:hover .bn__img { transform: scale(1.04); }
  a.bn:hover .bn__go :global(svg) { transform: rotate(45deg); }

  .bn--ask { grid-template-columns: 1fr; min-height: 0; background: var(--c-mint); }
  .bn--ask .bn__body { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'num title cta' 'num text cta'; align-items: center; gap: 4px var(--sp-5); padding: var(--sp-6) var(--sp-7); }
  .bn--ask .bn__num { grid-area: num; margin: 0; }
  .bn--ask .bn__title { grid-area: title; }
  .bn--ask .bn__text { grid-area: text; }
  .bn--ask .bn__cta { grid-area: cta; margin: 0; }
  .bn--ask .bn__text { color: var(--c-ink); font-size: var(--fs-body); max-width: 48ch; }
  .bn__num--ask { background: var(--c-white); color: var(--c-ink); font-size: 1.125rem; }
  .bn__cta { margin-top: auto; }

  @media (max-width: 1199px) {
    .bn-grid { grid-template-columns: 1fr; }
    .bn { min-height: 360px; }
  }
  @media (max-width: 1199px) {
    .bn--ask .bn__body { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'num title' 'text text' 'cta cta'; }
    .bn--ask .bn__cta { justify-self: start; margin-top: var(--sp-3); }
  }
  @media (max-width: 767px) {
    .bn-grid { gap: 12px; }
    .bn--wide .bn__lists { grid-template-columns: 1fr; gap: var(--sp-4); }
    .bn { grid-template-columns: 1fr; min-height: 0; border-radius: var(--radius-md); }
    .bn__media { order: -1; aspect-ratio: 16 / 10; }
    .bn__go { top: 12px; right: 12px; width: 40px; height: 40px; }
    .bn__body { padding: var(--sp-5); }
    .bn--ask .bn__body { padding: var(--sp-6) var(--sp-5); }
    .bn__cta { width: 100%; margin-top: var(--sp-3); }
  }
</style>
