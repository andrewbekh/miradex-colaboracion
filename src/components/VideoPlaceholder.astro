---
// Video slot for the B2B films (scripts: docs/Miradex_Spain_b2b.docx). Placeholder poster until the films are edited.
// Clean poster: play button in the centre, no film number, duration or pattern on top (client feedback).
import { ui } from '../data/ui';
import Icon from './Icon.astro';

interface Props { num: number; title: string; duration?: string; poster?: string; id?: string; bare?: boolean }
const { num, title, poster = '/img/photos/atlas-villas.jpg', id = `video-${num}` } = Astro.props;
---
<figure class="video" id={id}>
  <button type="button" class="video__frame" data-video={num} aria-label={ui.video.play(title)}>
    <img src={poster} alt="" loading="lazy" />
    <span class="video__play"><Icon name="play" size={34} /></span>
  </button>
</figure>

<style>
  .video__frame {
    position: relative; display: block; width: 100%; aspect-ratio: 16/9; padding: 0; border: 0; overflow: hidden; border-radius: var(--radius-lg);
    container-type: inline-size; background: var(--c-grey);
  }
  .video__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .video__frame:hover img { transform: scale(1.03); }
  .video__play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: clamp(56px, 11cqw, 112px); aspect-ratio: 1; border-radius: var(--radius-lg); background: var(--c-blue); color: var(--c-white);
    box-shadow: 0 12px 32px rgb(53 53 53 / 0.18);
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .video__play :global(svg) { margin-left: 4px; fill: currentColor; }
  .video__frame:hover .video__play { background: var(--c-blue-hover); transform: translate(-50%, -50%) scale(1.04); }
</style>
