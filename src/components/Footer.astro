---
// Footer with the full B2B map (strategy 9.2): formats, every sector, product lines, contacts.
import { scenarios } from '../data/scenarios';
import { sectorLinks, productLines } from '../data/nav';
import { site } from '../data/site';
import logo from '../assets/logo.svg?raw';

const half = Math.ceil(sectorLinks.length / 2);
---
<footer class="ft">
  <div class="container">
    <div class="ft__grid">
      <div class="ft__brand">
        <a href="/" class="ft__logo" aria-label="MIRADEX" set:html={logo} />
        <p class="ft__desc">Marca europea de vallas metálicas modernas. Fábrica en Rumanía, acero KG Dongbu Steel, más de 1000 proyectos en la UE.</p>
        <ul class="ft__contacts" role="list">
          <li>{site.contacts.phone}</li>
          <li><a href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a></li>
        </ul>
      </div>
      <nav class="ft__col" aria-label="Formatos de colaboración">
        <p class="ft__title">Formatos de colaboración</p>
        <ul role="list">
          {scenarios.map((s) => <li><a href={s.href}>{s.title}</a></li>)}
          <li><a href="/colaboracion/recomendar">Programa de referidos MIRADEX</a></li>
          <li><a href="#">Stands de demostración</a></li>
          <li><a href={site.hubPath} class="ft__all">Todas las opciones de colaboración</a></li>
        </ul>
      </nav>
      <nav class="ft__col ft__col--sectors" aria-label="Colaboración por sector">
        <p class="ft__title">Por sector</p>
        <div class="ft__split">
          <ul role="list">{sectorLinks.slice(0, half).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          <ul role="list">{sectorLinks.slice(half).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      </nav>
      <nav class="ft__col" aria-label="Productos">
        <p class="ft__title">Productos</p>
        <ul role="list">{productLines.map((p) => <li><a href="#">{p.title}</a></li>)}</ul>
      </nav>
    </div>
    <div class="ft__bottom">
      <p>© {new Date().getFullYear()} MIRADEX. Todos los derechos reservados.</p>
      <a href={site.privacyUrl}>Política de privacidad</a>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--bg-tint); border-top: 1px solid var(--border); padding-top: var(--sp-10); font-size: var(--fs-small); }
  .ft__grid { display: grid; grid-template-columns: 1.2fr 1fr 2fr 0.9fr; gap: var(--sp-7); }
  .ft__logo { display: block; width: 132px; color: var(--c-ink); }
  .ft__logo :global(svg) { width: 100%; height: auto; }
  .ft__desc { margin-top: var(--sp-4); color: var(--text-muted); max-width: 34ch; }
  .ft__contacts { margin-top: var(--sp-4); display: grid; gap: var(--sp-2); }
  .ft__title { font-size: var(--fs-micro); font-weight: var(--fw-medium); letter-spacing: var(--tracking-label); text-transform: uppercase; margin-bottom: var(--sp-4); }
  .ft ul { display: grid; gap: 10px; align-content: start; }
  .ft a { color: var(--text); text-decoration: none; }
  .ft a:hover { text-decoration: underline; }
  .ft__all { font-weight: var(--fw-medium); }
  .ft__split { display: grid; grid-template-columns: 1fr 1fr; gap: 10px var(--sp-6); }
  .ft__bottom { display: flex; justify-content: space-between; gap: var(--sp-4); flex-wrap: wrap; margin-top: var(--sp-9); padding-block: var(--sp-5); border-top: 1px solid var(--border); color: var(--text-muted); }
  @media (max-width: 1199px) {
    .ft__grid { grid-template-columns: 1fr 1fr; }
    .ft__col--sectors { grid-column: 1 / -1; grid-row: 3; }
  }
  @media (max-width: 767px) {
    .ft__grid { grid-template-columns: 1fr; }
    .ft__col--sectors { grid-row: auto; }
    .ft__split { grid-template-columns: 1fr; }
  }
</style>
