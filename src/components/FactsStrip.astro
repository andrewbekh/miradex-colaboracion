---
import { ui } from '../data/ui';
// Proof strip (reference: "Работаем по всей Европе. Европейский бренд, сталь из Южной Кореи").
interface Fact { value: string; label: string }
interface Props { facts?: Fact[]; tone?: 'light' | 'dark' }
const {
  facts = ui.facts,
  tone = 'light',
} = Astro.props;
---
<dl class:list={['facts', `facts--${tone}`, { 'facts--three': facts.length === 3 }]}>
  {facts.map((f) => (
    <div class="facts__item">
      <dt class="facts__value">{f.value}</dt>
      <dd class="facts__label">{f.label}</dd>
    </div>
  ))}
</dl>

<style>
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .facts__item { display: flex; flex-direction: column; gap: var(--sp-2); padding: var(--sp-6) var(--sp-5) var(--sp-6) 0; }
  .facts__item + .facts__item { padding-left: var(--sp-5); border-left: 1px solid var(--border); }
  .facts__value { order: 2; font-size: var(--fs-stat); font-weight: var(--fw-medium); line-height: 1; text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .facts__label { order: 3; color: var(--text-muted); font-size: var(--fs-small); max-width: 24ch; }
  .facts--dark { border-color: rgb(255 255 255 / 0.16); }
  .facts--dark .facts__item + .facts__item { border-color: rgb(255 255 255 / 0.16); }
  .facts--dark .facts__label { color: var(--text-on-accent-muted); }

  .facts--three { grid-template-columns: repeat(3, 1fr); }

  @media (max-width: 1199px) {
    .facts:not(.facts--three) { grid-template-columns: repeat(2, 1fr); }
    .facts:not(.facts--three) .facts__item:nth-child(3) { padding-left: 0; border-left: 0; }
    .facts:not(.facts--three) .facts__item:nth-child(n + 3) { border-top: 1px solid var(--border); }
    .facts--dark.facts .facts__item:nth-child(n + 3) { border-color: rgb(255 255 255 / 0.16); }
  }
  @media (max-width: 767px) {
    .facts__item { padding-block: var(--sp-5); }
    .facts:not(.facts--three) .facts__item:nth-child(even) { padding-left: var(--sp-4); }
    .facts:not(.facts--three) .facts__item:nth-child(3) { padding-left: 0; }
    .facts--three { grid-template-columns: 1fr; }
    .facts--three .facts__item, .facts--three .facts__item + .facts__item { padding-left: 0; border-left: 0; }
    .facts--three .facts__item + .facts__item { border-top: 1px solid var(--border); }
  }
</style>
