---
import { ui } from '../data/ui';
// Proof strip (reference: "Работаем по всей Европе. Производство в Румынии, сталь из Южной Кореи. 1000+ проектов в ЕС").
interface Fact { value: string; label: string }
interface Props { facts?: Fact[]; tone?: 'light' | 'dark' }
const {
  facts = ui.facts,
  tone = 'light',
} = Astro.props;
const swatches = ['blue', 'sky', 'mint', 'blue'];
---
<dl class:list={['facts', `facts--${tone}`]}>
  {facts.map((f, i) => (
    <div class="facts__item">
      <span class={`facts__mark facts__mark--${swatches[i % 4]}`} aria-hidden="true" />
      <dt class="facts__value">{f.value}</dt>
      <dd class="facts__label">{f.label}</dd>
    </div>
  ))}
</dl>

<style>
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .facts__item { display: flex; flex-direction: column; gap: var(--sp-2); padding: var(--sp-6) var(--sp-5) var(--sp-6) 0; }
  .facts__item + .facts__item { padding-left: var(--sp-5); border-left: 1px solid var(--border); }
  .facts__mark { width: 28px; height: 8px; margin-bottom: var(--sp-3); border-radius: 2px; }
  .facts__mark--blue { background: var(--c-blue); }
  .facts__mark--sky { background: var(--c-sky); }
  .facts__mark--mint { background: var(--c-mint); }
  .facts__value { order: 2; font-size: var(--fs-stat); font-weight: var(--fw-medium); line-height: 1; text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .facts__label { order: 3; color: var(--text-muted); font-size: var(--fs-small); max-width: 24ch; }
  .facts__mark { order: 1; }
  .facts--dark { border-color: rgb(255 255 255 / 0.16); }
  .facts--dark .facts__item + .facts__item { border-color: rgb(255 255 255 / 0.16); }
  .facts--dark .facts__label { color: var(--text-on-dark-muted); }

  @media (max-width: 1199px) {
    .facts { grid-template-columns: repeat(2, 1fr); }
    .facts .facts__item:nth-child(3) { padding-left: 0; border-left: 0; }
    .facts .facts__item:nth-child(n + 3) { border-top: 1px solid var(--border); }
    .facts--dark.facts .facts__item:nth-child(n + 3) { border-color: rgb(255 255 255 / 0.16); }
  }
  @media (max-width: 767px) {
    .facts__item { padding-block: var(--sp-5); }
    .facts .facts__item:nth-child(even) { padding-left: var(--sp-4); }
    .facts .facts__item:nth-child(3) { padding-left: 0; }
  }
</style>
