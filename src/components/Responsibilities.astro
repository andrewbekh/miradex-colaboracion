---
// "Sin riesgos" adapted to B2B: who takes care of what (strategy, section 2 roles).
import Icon from './Icon.astro';
interface Props { miradex: string[]; partner: string[]; miradexTitle?: string; partnerTitle?: string; note?: string }
const { miradex, partner, miradexTitle = 'MIRADEX se encarga de', partnerTitle = 'Usted se encarga de', note } = Astro.props;
---
<div class="resp">
  <section class="resp__col resp__col--mx">
    <h3 class="resp__title">{miradexTitle}</h3>
    <ul role="list">
      {miradex.map((t) => <li><Icon name="check" size={20} /><span>{t}</span></li>)}
    </ul>
  </section>
  <section class="resp__col resp__col--you">
    <h3 class="resp__title">{partnerTitle}</h3>
    <ul role="list">
      {partner.map((t) => <li><Icon name="arrow-right" size={20} /><span>{t}</span></li>)}
    </ul>
    {note && <p class="resp__note">{note}</p>}
  </section>
</div>

<style>
  .resp { display: grid; grid-template-columns: 1.15fr 1fr; border-radius: var(--radius-md); overflow: hidden; }
  .resp__col { padding: var(--sp-8) var(--sp-7); display: grid; align-content: start; gap: var(--sp-5); }
  .resp__col--mx { background: var(--bg-dark); color: var(--text-on-dark); }
  .resp__col--you { background: var(--bg); border: 1px solid var(--border); border-left: 0; border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .resp__title { font-size: var(--fs-h3); }
  .resp ul { display: grid; gap: var(--sp-4); }
  .resp li { display: grid; grid-template-columns: 24px 1fr; gap: var(--sp-3); align-items: start; }
  .resp__col--mx li :global(svg) { color: var(--c-blue); margin-top: 1px; }
  .resp__col--you li :global(svg) { color: var(--text-muted); margin-top: 1px; }
  .resp__note { color: var(--text-muted); font-size: var(--fs-small); padding-top: var(--sp-3); border-top: 1px solid var(--border); }
  @media (max-width: 1199px) { .resp__col { padding: var(--sp-7) var(--sp-6); } }
  @media (max-width: 767px) {
    .resp { grid-template-columns: 1fr; }
    .resp__col { padding: var(--sp-6) var(--sp-5); }
    .resp__col--you { border-left: 1px solid var(--border); border-top: 0; border-radius: 0 0 var(--radius-md) var(--radius-md); }
  }
</style>
