---
// Page bar that slides in once the first screen is scrolled past, on the hub and on every landing
// (Leroy Merlin pattern): where you are + chevron to switch to another format, back to the hub on landings,
// and «Оставить заявку». Desktop and tablet: docked under the header. Mobile: fixed at the bottom of the screen.
// The bar is brand blue with everything on it inverted: white text, mint button (client rule for blue).
// The first screen marks its end with [data-sbar-after]; without it the bar appears after 600px.
import Icon from './Icon.astro';
import { ui } from '../data/ui';
import { site } from '../data/site';
import { scenarios, scenarioById, toneStyle } from '../data/scenarios';

interface Props { current?: string }
const { current } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const show = path.startsWith(site.hubPath);
const sc = scenarioById(current);
---
{show && (
  <div class="sb on-blue" data-sbar aria-hidden="true" inert>
    <div class="container sb__in">
      {sc && (
        <a class="sb__back" href={site.hubPath} aria-label={ui.sbar.back}>
          <Icon name="arrow-left" size={18} /><span class="sb__back-text">{site.navLabel}</span>
        </a>
      )}
      <div class="sb__where" data-sbar-menu>
        <button class="sb__switch" type="button" aria-expanded="false" aria-controls="sbar-list" data-sbar-toggle>
          <span class="sb__here">{ui.sbar.here}</span>
          {sc
            ? <><span class="sb__num" style={toneStyle(sc.tone)}>{sc.num}</span><span class="sb__cur"><span class="sb__long">{sc.title}</span><span class="sb__short">{sc.short}</span></span></>
            : <span class="sb__cur"><span class="sb__long">{ui.sbar.hub}</span><span class="sb__short">{ui.sbar.hubShort}</span></span>}
          <Icon name="chevron-down" size={18} class="sb__chev" />
        </button>
        <div class="sb__list" id="sbar-list">
          <p class="sb__list-title">{ui.sbar.other}</p>
          <ul role="list">
            {scenarios.map((s) => (
              <li>
                <a href={s.href} class:list={['sb__link', { 'is-current': s.id === current }]} aria-current={s.id === current ? 'page' : undefined}>
                  <span class="sb__num" style={toneStyle(s.tone)}>{s.num}</span><span>{s.title}</span>
                </a>
              </li>
            ))}
            <li class="sb__all">
              <a href={site.hubPath} class:list={['sb__link', { 'is-current': !sc }]} aria-current={!sc ? 'page' : undefined}>
                <span>{ui.header.allOptions}</span><Icon name="arrow-right" size={16} />
              </a>
            </li>
          </ul>
        </div>
      </div>
      <button type="button" class="btn btn--primary sb__cta" data-open-form data-scenario={sc?.id ?? 'no-se'}>
        <span class="sb__cta-long">{ui.cta.apply}</span><span class="sb__cta-short">{ui.cta.applyShort}</span>
      </button>
    </div>
  </div>
)}

<style>
  .sb {
    position: fixed; left: 0; right: 0; top: calc(var(--header-h) + 1px); z-index: 45;
    background: var(--c-blue); color: var(--c-white); box-shadow: var(--shadow-soft);
    transform: translateY(-8px); opacity: 0; visibility: hidden;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease), visibility var(--dur);
  }
  .sb.is-on { transform: none; opacity: 1; visibility: visible; }
  :global(.hd.is-menu-open) ~ .sb { visibility: hidden; }
  .sb__in { display: flex; align-items: center; gap: var(--sp-4); min-height: 64px; }

  .sb__back {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px 0 10px; border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.18); color: var(--c-white); text-decoration: none; font-size: var(--fs-small); font-weight: var(--fw-medium); flex: none;
  }
  .sb__back:hover { background: rgb(255 255 255 / 0.28); }

  .sb__where { position: relative; min-width: 0; }
  .sb__switch {
    display: inline-flex; align-items: center; gap: 10px; max-width: 100%; height: 44px; padding: 0 10px; border: 0; border-radius: var(--radius-sm);
    background: transparent; color: var(--c-white); font-size: var(--fs-small); text-align: left; min-width: 0;
  }
  .sb__switch:hover, .sb__switch[aria-expanded='true'] { background: rgb(255 255 255 / 0.18); }
  .sb__here { color: rgb(255 255 255 / 0.85); flex: none; }
  .sb__cur { font-weight: var(--fw-medium); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .sb__short { display: none; }
  .sb__num { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: var(--radius-xs); font-size: 12px; font-weight: var(--fw-medium); }
  /* on the blue bar the current number is a white tile; tone colours stay in the white list */
  .sb__switch .sb__num { background: var(--c-white) !important; color: var(--c-ink) !important; }
  .sb__list { color: var(--c-ink); }
  .sb__switch :global(.sb__chev) { flex: none; transition: transform var(--dur) var(--ease); }
  .sb__switch[aria-expanded='true'] :global(.sb__chev) { transform: rotate(180deg); }

  .sb__list {
    position: absolute; left: 0; top: calc(100% + 10px); width: 380px; padding: var(--sp-2);
    background: var(--c-white); border: 1px solid var(--border); border-radius: var(--radius-md); box-shadow: var(--shadow-pop);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), visibility var(--dur);
  }
  .sb__where.is-open .sb__list { opacity: 1; visibility: visible; transform: none; }
  .sb__list-title { padding: 8px 12px 6px; font-size: var(--fs-micro); color: var(--text-muted); }
  .sb__link { display: flex; align-items: center; gap: var(--sp-3); padding: 10px 12px; border-radius: var(--radius-sm); color: var(--c-ink-80); text-decoration: none; font-size: var(--fs-small); }
  .sb__link:hover { color: var(--c-ink); background: var(--c-grey); }
  .sb__link.is-current { color: var(--c-ink); font-weight: var(--fw-medium); background: var(--c-grey); }
  .sb__all { margin-top: var(--sp-2); padding-top: var(--sp-2); border-top: 1px solid var(--border); }
  .sb__all .sb__link { justify-content: space-between; color: var(--c-ink); font-weight: var(--fw-medium); }

  .sb__cta { margin-left: auto; --btn-h: 48px; flex: none; }
  .sb__cta-short { display: none; }

  @media (max-width: 1199px) {
    .sb__here { display: none; }
  }
  /* mobile: thumb-reach bar at the bottom, the list opens upwards */
  @media (max-width: 767px) {
    .sb { top: auto; bottom: 0; box-shadow: 0 -8px 24px rgb(53 53 53 / 0.12); transform: translateY(8px); padding-bottom: env(safe-area-inset-bottom); }
    .sb__in { gap: var(--sp-2); min-height: 64px; }
    .sb__back { width: 44px; padding: 0; justify-content: center; }
    .sb__back-text { display: none; }
    .sb__where { flex: 1; position: static; }
    .sb__switch { width: 100%; padding: 0 8px; gap: 8px; }
    .sb__long { display: none; }
    .sb__short { display: inline; }
    .sb__cur { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.2; font-size: var(--fs-micro); }
    .sb__switch :global(.sb__chev) { margin-left: auto; transform: rotate(180deg); }
    .sb__switch[aria-expanded='true'] :global(.sb__chev) { transform: none; }
    .sb__list { left: var(--gutter); right: var(--gutter); top: auto; bottom: calc(100% + 8px); width: auto; transform: translateY(4px); }
    .sb__cta { --btn-h: 44px; padding: 0 16px; }
    .sb__cta-long { display: none; }
    .sb__cta-short { display: inline; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sbar]');
  if (bar) {
    const after = document.querySelector<HTMLElement>('[data-sbar-after]');
    const header = document.querySelector<HTMLElement>('[data-header]');
    const menu = bar.querySelector<HTMLElement>('[data-sbar-menu]')!;
    const toggle = bar.querySelector<HTMLButtonElement>('[data-sbar-toggle]')!;
    const setOpen = (open: boolean) => { menu.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', String(open)); };
    let on = false;
    const update = () => {
      const edge = after ? after.getBoundingClientRect().bottom : 600 - window.scrollY;
      const next = edge < (header?.offsetHeight ?? 72);
      if (next === on) return;
      on = next;
      bar.classList.toggle('is-on', on);
      bar.toggleAttribute('inert', !on);
      bar.setAttribute('aria-hidden', String(!on));
      document.documentElement.classList.toggle('has-sbar', on);
      if (!on) setOpen(false);
    };
    let raf = 0;
    window.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);
    update();
    toggle.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!menu.classList.contains('is-open')); });
    menu.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setOpen(false); toggle.focus(); } });
    document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) setOpen(false); });
  }
</script>
