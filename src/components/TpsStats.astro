---
// Production base statistics. The numbers belong to TPS, not only to the MIRADEX brand,
// so they never appear without the sentence that says so. Not to be placed right after the first-screen strip.
import FactsStrip from './FactsStrip.astro';
import { ui } from '../data/ui';
---
<div class="tps">
  <p class="tps__text">{ui.tps.text}</p>
  <FactsStrip facts={ui.tps.stats} />
</div>

<style>
  .tps { display: grid; gap: var(--sp-5); }
  .tps__text { font-size: var(--fs-lead); font-weight: var(--fw-medium); line-height: 1.2; }
</style>
