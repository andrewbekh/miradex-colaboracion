---
// Films with their text; the layout follows how many films a page has:
// 1: the film full width, text under it · 2: two large · 3: three in a row ·
// 4: two by two · 5: two large on top, three below. Phones: one film stacked, several scroll sideways.
import VideoPlaceholder from './VideoPlaceholder.astro';
import Icon from './Icon.astro';
import type { VideoRow } from '../data/landings/types';
import { videos } from '../data/videos';
import { ui } from '../data/ui';

interface Props { items: VideoRow[]; scenario?: string }
const { items } = Astro.props;
const single = items.length === 1;
---
<ol class:list={['vr', single ? 'vr--single' : 'vr--cards', `vr--n${Math.min(items.length, 5)}`]} role="list">
  {items.map((row) => {
    const v = videos[row.num];
    return (
      <li class="vr__item">
        <div class="vr__media"><VideoPlaceholder num={v.num} title={v.title} duration={v.duration} poster={v.poster} bare /></div>
        <div class="vr__text">
          <div class="vr__head">
            <p class="vr__for"><span class="eyebrow">{ui.videosRow.forWhom}</span><span>{row.audience}</span></p>
            <h3 class="vr__title">{v.title}</h3>
            <p class="vr__lead">{row.lead}</p>
          </div>
          <a class="btn btn--mint btn--sm vr__watch" href={`#video-${v.num}`} data-video-proxy={`video-${v.num}`}>
            <Icon name="play" size={16} /><span>{ui.video.watch}</span>
          </a>
        </div>
      </li>
    );
  })}
</ol>

<style>
  .vr__text { display: grid; gap: var(--sp-3); align-content: start; }
  .vr__head { display: grid; gap: var(--sp-3); justify-items: start; align-content: start; }
  .vr__for { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: var(--fs-small); color: var(--text-muted); }
  .vr__for .eyebrow { padding: 4px 10px; border-radius: 999px; background: var(--c-mint); color: var(--c-ink); }
  .vr__title { font-size: var(--fs-h3); line-height: 1.25; }
  .vr__lead { color: var(--text-muted); }
  .vr__watch { justify-self: start; margin-top: var(--sp-2); }

  /* one film: full width, text under it */
  .vr--single .vr__item { display: grid; gap: var(--sp-6); }

  /* several films: a 6-column grid, spans set by the count */
  .vr--cards { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--sp-7) var(--grid-gap); }
  .vr--cards .vr__item { display: grid; gap: var(--sp-4); align-content: start; grid-column: span 2; }
  .vr--n2 .vr__item, .vr--n4 .vr__item, .vr--n5 .vr__item:nth-child(-n + 2) { grid-column: span 3; }
  .vr--cards .vr__title { font-size: 1.0625rem; }
  .vr--cards .vr__lead { font-size: var(--fs-small); }
  .vr--n2 .vr__title, .vr--n4 .vr__title, .vr--n5 .vr__item:nth-child(-n + 2) .vr__title { font-size: var(--fs-h3); }

  @media (max-width: 1023px) {
    .vr--cards .vr__item, .vr--n5 .vr__item:nth-child(-n + 2) { grid-column: span 3; }
  }
  @media (max-width: 767px) {
    .vr.vr--cards {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
    }
    .vr--cards::-webkit-scrollbar { display: none; }
    .vr--cards .vr__item { flex: 0 0 82%; scroll-snap-align: start; }
  }
</style>
