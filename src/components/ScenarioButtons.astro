---
// Last chance to choose (after the form): the five formats as white buttons on a mint band.
import Icon from './Icon.astro';
import { scenarios } from '../data/scenarios';
interface Props { title?: string }
const { title = '¿Prefiere ver primero los detalles? Elija su formato' } = Astro.props;
---
<nav class="sbn" aria-label="Formatos de colaboración">
  <div class="container sbn__in">
    <p class="sbn__title">{title}</p>
    <ul class="sbn__list" role="list">
      {scenarios.map((s) => (
        <li><a class="sbn__btn" href={s.href}><span class="sbn__num">{s.num}</span><span>{s.short}</span><Icon name="arrow-right" size={18} /></a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .sbn { padding-block: clamp(40px, 1rem + 3vw, 72px); background: var(--c-mint); }
  .sbn__in { display: grid; gap: var(--sp-5); }
  .sbn__title { font-size: var(--fs-h3); font-weight: var(--fw-medium); text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .sbn__list { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  .sbn__btn {
    display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 0 16px 0 12px; border-radius: var(--radius-sm);
    background: var(--c-white); color: var(--c-ink); text-decoration: none; font-weight: var(--fw-medium); font-size: var(--fs-small);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .sbn__num { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: var(--radius-xs); background: var(--c-blue); color: var(--c-white); font-size: 12px; }
  .sbn__btn :global(svg) { margin-left: auto; flex: none; transition: transform var(--dur) var(--ease); }
  .sbn__btn:hover { background: var(--c-blue); color: var(--c-white); }
  .sbn__btn:hover .sbn__num { background: var(--c-white); color: var(--c-ink); }
  .sbn__btn:hover :global(svg) { transform: translateX(3px); }
  @media (max-width: 1199px) { .sbn__list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 767px) { .sbn__list { grid-template-columns: 1fr; } }
</style>
