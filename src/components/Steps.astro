---
// How cooperation starts (strategy 6.8): 6 steps. Row on desktop, 3×2 on tablet, vertical on mobile.
interface Step { title: string; text: string }
interface Props { steps: Step[]; tone?: 'light' | 'dark' }
const { steps, tone = 'light' } = Astro.props;
const swatches = ['blue', 'sky', 'mint'];
---
<ol class:list={['steps', `steps--${tone}`]} role="list" style={`--n:${steps.length}`}>
  {steps.map((s, i) => (
    <li class="steps__item">
      <span class={`steps__num steps__num--${swatches[i % 3]}`}>{String(i + 1).padStart(2, '0')}</span>
      <h3 class="steps__title">{s.title}</h3>
      <p class="steps__text">{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: var(--grid-gap); counter-reset: s; }
  .steps__item { position: relative; display: grid; align-content: start; gap: var(--sp-3); padding-top: var(--sp-5); border-top: 2px solid var(--c-ink); }
  .steps--dark .steps__item { border-color: rgb(255 255 255 / 0.85); }
  .steps__num { display: grid; place-items: center; width: 44px; height: 44px; font-weight: var(--fw-medium); font-size: var(--fs-small); color: var(--c-ink); margin-bottom: var(--sp-2); border-radius: var(--radius-sm); }
  .steps__num--blue { background: var(--c-blue); color: var(--c-white); }
  .steps__num--sky { background: var(--c-sky); color: var(--c-white); }
  .steps__num--mint { background: var(--c-mint); }
  .steps__title { font-size: 1.0625rem; }
  .steps__text { color: var(--text-muted); font-size: var(--fs-small); }
  .steps--dark .steps__text { color: var(--text-on-accent-muted); }
  @media (max-width: 1199px) { .steps { grid-template-columns: repeat(3, 1fr); row-gap: var(--sp-7); } }
  @media (max-width: 767px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps__item { grid-template-columns: 44px 1fr; column-gap: var(--sp-4); row-gap: var(--sp-1); padding: var(--sp-4) 0 var(--sp-5); border-top: 0; border-left: 0; }
    .steps__item:not(:last-child)::after { content: ''; position: absolute; left: 21px; top: 60px; bottom: 0; width: 2px; background: var(--border); }
    .steps__num { grid-row: span 2; margin: 0; }
  }
</style>
