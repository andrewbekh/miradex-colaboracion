---
// How cooperation starts (strategy 6.8): numbered points on one line that connects them, so it reads as a sequence.
// Desktop: one row. Tablet and phones: a vertical line down the left with the text beside each point.
interface Step { title: string; text: string }
interface Props { steps: Step[]; tone?: 'light' | 'dark' }
const { steps } = Astro.props;
---
<ol class="steps" role="list" style={`--n:${steps.length}`}>
  {steps.map((s, i) => (
    <li class="steps__item">
      <span class="steps__num">{i + 1}</span>
      <div class="steps__body">
        <h3 class="steps__title">{s.title}</h3>
        <p class="steps__text">{s.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .steps { --dot: 40px; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--grid-gap); }
  .steps__item { position: relative; display: grid; align-content: start; gap: var(--sp-4); }
  /* the connecting line: from this point to the next one */
  .steps__item:not(:last-child)::after {
    content: ''; position: absolute; top: calc(var(--dot) / 2); left: calc(var(--dot) + 8px); right: calc(-1 * var(--grid-gap) + 8px);
    height: 2px; background: var(--c-blue); transform: translateY(-50%);
  }
  .steps__num {
    position: relative; z-index: 1; display: grid; place-items: center; width: var(--dot); height: var(--dot); border-radius: 50%;
    background: var(--c-blue); color: var(--c-white); font-weight: var(--fw-medium); font-size: var(--fs-small);
  }
  .steps__body { display: grid; gap: var(--sp-2); padding-right: var(--sp-3); }
  .steps__title { font-size: 1.0625rem; line-height: 1.25; }
  .steps__text { color: var(--text-muted); font-size: var(--fs-small); }

  @media (max-width: 1199px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps__item { grid-template-columns: var(--dot) 1fr; column-gap: var(--sp-4); padding-bottom: var(--sp-6); }
    .steps__item:last-child { padding-bottom: 0; }
    .steps__item:not(:last-child)::after { top: calc(var(--dot) + 8px); bottom: 8px; left: calc(var(--dot) / 2); right: auto; width: 2px; height: auto; transform: translateX(-50%); }
    .steps__body { padding-top: 8px; }
  }
</style>
