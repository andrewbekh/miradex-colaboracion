---
// FAQ accordion on native <details>. Answers may contain HTML (links, TODO markers).
interface QA { q: string; a: string }
interface Props { items: QA[]; openFirst?: boolean }
const { items, openFirst = true } = Astro.props;
---
<div class="faq">
  {items.map((it, i) => (
    <details class="faq__item" open={openFirst && i === 0}>
      <summary class="faq__q"><span>{it.q}</span><span class="faq__ic" aria-hidden="true" /></summary>
      <div class="faq__a" set:html={it.a} />
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--border); }
  .faq__item { border-bottom: 1px solid var(--border); }
  .faq__q {
    list-style: none; cursor: pointer; display: grid; grid-template-columns: 1fr 32px; gap: var(--sp-5); align-items: center;
    padding: var(--sp-5) 0; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); font-weight: var(--fw-medium); line-height: 1.3;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__ic { position: relative; width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--c-mint); transition: background-color var(--dur) var(--ease); }
  .faq__ic::before, .faq__ic::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 1.5px; background: var(--c-ink); transform: translate(-50%, -50%); transition: transform var(--dur) var(--ease); }
  .faq__ic::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item[open] .faq__ic { background: var(--c-blue); }
  .faq__item[open] .faq__ic::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq__q:hover .faq__ic { background: var(--c-sky); }
  .faq__item[open] .faq__ic::before, .faq__item[open] .faq__ic::after,
  .faq__q:hover .faq__ic::before, .faq__q:hover .faq__ic::after { background: var(--c-white); }
  .faq__a { padding: 0 var(--sp-9) var(--sp-6) 0; color: var(--text-muted); max-width: 72ch; }
  .faq__a :global(p + p) { margin-top: var(--sp-3); }
  @media (max-width: 767px) { .faq__a { padding-right: 0; } }
</style>
