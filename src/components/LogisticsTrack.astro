---
// Order to site timeline (video scripts nº3 and nº4): production 3-5 days, delivery 5-10, up to 15 working days.
import Icon from './Icon.astro';
interface Stage { title: string; time: string; text: string; weight: number; tone: 'blue' | 'sky' | 'mint' | 'ink' }
interface Props { stages: Stage[]; total: string; notes?: { icon: string; text: string }[] }
const { stages, total, notes = [] } = Astro.props;
---
<div class="lt">
  <div class="lt__track" role="list">
    {stages.map((s) => (
      <div class="lt__stage" role="listitem" style={`--w:${s.weight}`}>
        <span class={`lt__bar lt__bar--${s.tone}`}><span class="lt__time">{s.time}</span></span>
        <h3 class="lt__title">{s.title}</h3>
        <p class="lt__text">{s.text}</p>
      </div>
    ))}
  </div>
  <p class="lt__total"><Icon name="clock" size={20} /><span>{total}</span></p>
  {notes.length > 0 && (
    <ul class="lt__notes" role="list">
      {notes.map((n) => <li><Icon name={n.icon} size={22} /><span set:html={n.text} /></li>)}
    </ul>
  )}
</div>

<style>
  .lt { display: grid; gap: var(--sp-6); }
  .lt__track { display: flex; gap: 6px; }
  .lt__stage { flex: var(--w) 1 0; min-width: 0; display: grid; align-content: start; gap: var(--sp-2); }
  .lt__bar { display: flex; align-items: center; height: 56px; padding: 0 var(--sp-4); border-radius: var(--radius-sm); margin-bottom: var(--sp-3); }
  .lt__bar--blue { background: var(--c-blue); color: var(--c-white); }
  .lt__bar--sky { background: var(--c-sky); color: var(--c-white); }
  .lt__bar--mint { background: var(--c-mint); }
  .lt__bar--ink { background: var(--c-ink); color: var(--c-white); }
  .lt__time { font-weight: var(--fw-medium); font-size: var(--fs-small); letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; }
  .lt__title { font-size: 1.0625rem; }
  .lt__text { color: var(--text-muted); font-size: var(--fs-small); max-width: 32ch; }
  .lt__total { display: inline-flex; align-items: center; gap: 10px; justify-self: start; padding: 10px 16px; border-radius: var(--radius-sm); background: var(--c-ink); color: var(--c-white); font-weight: var(--fw-medium); }
  .lt__notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); }
  .lt__notes li { display: grid; grid-template-columns: 22px 1fr; gap: var(--sp-3); padding: var(--sp-5); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg); color: var(--text-muted); font-size: var(--fs-small); }
  .lt__notes :global(svg) { color: var(--c-ink); }
  @media (max-width: 1199px) {
    .lt__notes { grid-template-columns: 1fr; }
    .lt__track { flex-direction: column; gap: var(--sp-4); }
    .lt__stage { display: grid; grid-template-columns: clamp(112px, 22vw, 168px) 1fr; column-gap: var(--sp-4); }
    .lt__bar { grid-row: span 2; height: 100%; min-height: 64px; margin: 0; justify-content: center; padding: 0 8px; }
    .lt__time { white-space: normal; text-align: center; }
  }
</style>
