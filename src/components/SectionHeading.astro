---
// Section heading: uppercase Medium title (brandbook) with an optional eyebrow and lead.
// No pattern next to headings: on the web it takes space without adding meaning (client feedback).
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  level?: 1 | 2;
  align?: 'start' | 'center';
  /** inverse = white text on a brand-blue plate */
  tone?: 'light' | 'inverse';
}
const { title, eyebrow, lead, level = 2, align = 'start', tone = 'light' } = Astro.props;
const Tag = level === 1 ? 'h1' : 'h2';
---
<header class:list={['sh', `sh--${align}`, `sh--${tone}`]}>
  {eyebrow && <p class="eyebrow sh__eyebrow">{eyebrow}</p>}
  <Tag class:list={['sh__title', level === 1 ? 'h-display' : 'h2']} set:html={title} />
  {lead && <p class="lead sh__lead">{lead}</p>}
  <slot />
</header>

<style>
  .sh { display: grid; gap: var(--sp-4); justify-items: start; }
  .sh--center { justify-items: center; text-align: center; }
  .sh__eyebrow { color: var(--text-muted); }
  .sh--inverse .sh__eyebrow { color: var(--text-on-accent-muted); }
  .sh__title { max-width: 26ch; text-wrap: balance; }
  .sh__title.h-display { max-width: 18ch; }
  .sh__lead { max-width: 60ch; color: var(--text-muted); }
  .sh--inverse .sh__lead { color: var(--text-on-accent-muted); }
</style>
