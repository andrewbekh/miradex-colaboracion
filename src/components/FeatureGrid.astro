---
// Icon + short title + one line. 3 / 2 / 1 columns.
import Icon from './Icon.astro';

interface Item { icon: string; title: string; text: string }
interface Props { items: Item[]; cols?: 2 | 3 | 4; tone?: 'light' }
const { items, cols = 3, tone = 'light' } = Astro.props;
---
<ul class:list={['fg', `fg--${cols}`, `fg--${tone}`]} role="list">
  {items.map((it) => (
    <li class="fg__item">
      <span class="fg__icon"><Icon name={it.icon} size={26} /></span>
      <h3 class="fg__title">{it.title}</h3>
      <p class="fg__text">{it.text}</p>
    </li>
  ))}
</ul>

<style>
  .fg { display: grid; gap: 0; border-top: 1px solid var(--border); }
  .fg--3 { grid-template-columns: repeat(3, 1fr); }
  .fg--2 { grid-template-columns: repeat(2, 1fr); }
  .fg--4 { grid-template-columns: repeat(4, 1fr); }
  .fg__item { display: grid; align-content: start; gap: var(--sp-3); padding: var(--sp-6) var(--sp-6) var(--sp-7) 0; border-bottom: 1px solid var(--border); }
  .fg__icon { display: grid; place-items: center; width: 56px; height: 56px; margin-bottom: var(--sp-3); color: var(--c-ink); border-radius: var(--radius-sm); }
  /* one colour for decorative icons: the brand colours as a cycle read like the format code */
  .fg__icon { background: var(--c-mint); }
  .fg__title { font-size: var(--fs-h3); }
  .fg__text { color: var(--text-muted); max-width: 34ch; }
  .fg--dark { border-color: rgb(255 255 255 / 0.16); }
  .fg--dark .fg__item { border-color: rgb(255 255 255 / 0.16); }
  .fg--dark .fg__text { color: var(--text-on-accent-muted); }

  @media (max-width: 1199px) {
    .fg--3, .fg--4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 767px) {
    .fg--3, .fg--4, .fg--2 { grid-template-columns: 1fr; }
    .fg__item { grid-template-columns: 48px 1fr; column-gap: var(--sp-4); padding: var(--sp-5) 0; }
    .fg__icon { grid-row: span 2; width: 48px; height: 48px; margin: 0; }
  }
</style>
