---
// One button for links, buttons and form triggers.
// `openForm` opens the lead-form popup; `scenario` preselects the cooperation format in it.
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'mint' | 'white';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconStart?: string;
  block?: boolean;
  openForm?: boolean;
  scenario?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', icon, iconStart, block = false, openForm = false, scenario, type = 'button', class: cls = '', ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, size !== 'md' && `btn--${size}`, block && 'btn--block', cls];
const data = openForm ? { 'data-open-form': '', 'data-scenario': scenario ?? '' } : {};
---
{href && !openForm ? (
  <a href={href} class:list={classes} {...rest}>
    {iconStart && <Icon name={iconStart} size={18} />}<span><slot /></span>{icon && <Icon name={icon} size={18} />}
  </a>
) : (
  <button type={type} class:list={classes} {...data} {...rest}>
    {iconStart && <Icon name={iconStart} size={18} />}<span><slot /></span>{icon && <Icon name={icon} size={18} />}
  </button>
)}
