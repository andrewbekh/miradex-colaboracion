---
// Popup with the shared lead form. Opened by any [data-open-form] element; [data-scenario] preselects the format.
// Also opens on load with ?form=1 (useful for ad links).
import { ui } from '../data/ui';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';

interface Props { scenario?: string }
const { scenario = '' } = Astro.props;
---
<dialog class="fm" id="lead-modal" aria-labelledby="lead-modal-title" data-default-scenario={scenario}>
  <div class="fm__panel" tabindex="-1" autofocus>
    <div class="fm__head">
      <div class="fm__head-row">
        <div>
          <p class="fm__title" id="lead-modal-title">{ui.modal.title}</p>
          <p class="fm__sub">{ui.modal.sub}</p>
        </div>
        <button type="button" class="fm__close" data-close-form aria-label={ui.modal.close}><Icon name="x" size={22} /></button>
      </div>
    </div>
    <div class="fm__body">
      <LeadForm uid="modal" scenario={scenario} layout="compact" />
    </div>
  </div>
</dialog>

<style>
  .fm { width: min(760px, calc(100vw - 32px)); max-height: calc(100dvh - 48px); padding: 0; border: 0; background: transparent; color: var(--text); overflow: visible; }
  .fm::backdrop { background: rgb(53 53 53 / 0.6); backdrop-filter: blur(2px); }
  .fm[open] { animation: fm-in 260ms var(--ease); }
  @keyframes fm-in { from { opacity: 0; transform: translateY(12px); } }
  .fm__panel:focus { outline: none; }
  .fm__panel { display: flex; flex-direction: column; max-height: calc(100dvh - 48px); border-radius: var(--radius-lg); overflow: hidden; background: var(--c-white); box-shadow: var(--shadow-pop); }
  .fm__head-row { display: grid; grid-template-columns: 1fr auto; gap: var(--sp-4); padding: var(--sp-5) var(--sp-6) var(--sp-4); border-bottom: 1px solid var(--border); }
  .fm__title { font-size: var(--fs-h3); font-weight: var(--fw-medium); text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .fm__sub { color: var(--text-muted); font-size: var(--fs-small); margin-top: 4px; }
  .fm__close { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--c-white); }
  .fm__close:hover { background: var(--c-grey); border-color: var(--c-grey); }
  .fm__body { overflow-y: auto; padding: var(--sp-6); overscroll-behavior: contain; }
  @media (max-width: 767px) {
    .fm { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; }
    .fm__panel { height: 100dvh; max-height: 100dvh; border-radius: 0; }
    .fm__head-row { padding: var(--sp-4) var(--sp-5); }
    .fm__body { padding: var(--sp-5); }
  }
</style>
