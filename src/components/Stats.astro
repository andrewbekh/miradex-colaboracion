---
// Product facts in one row: the number on top, what it means under it, left-aligned in every cell.
interface Stat { value: string; label: string }
interface Props { stats: Stat[]; footnote?: string }
const { stats, footnote } = Astro.props;
---
<div class="st">
  <dl class="st__grid" style={`--n:${stats.length}`}>
    {stats.map((s) => (
      <div class="st__item">
        <dt class="st__value">{s.value}</dt>
        <dd class="st__label">{s.label}</dd>
      </div>
    ))}
  </dl>
  {footnote && <p class="st__foot">{footnote}</p>}
</div>

<style>
  .st__grid { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .st__item { display: grid; align-content: start; gap: var(--sp-2); padding: var(--sp-6); }
  .st__item + .st__item { border-left: 1px solid var(--border); }
  .st__value { font-size: var(--fs-stat); font-weight: var(--fw-medium); line-height: 1; letter-spacing: var(--tracking-caps); white-space: nowrap; }
  .st__label { color: var(--text-muted); font-size: var(--fs-small); }
  .st__foot { margin-top: var(--sp-3); font-size: var(--fs-micro); color: var(--text-muted); }
  @media (max-width: 1023px) {
    .st__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .st__item:nth-child(odd) { border-left: 0; }
    .st__item:nth-child(n + 3) { border-top: 1px solid var(--border); }
  }
  @media (max-width: 767px) {
    .st__item { padding: var(--sp-4); }
    .st__value { font-size: clamp(1.5rem, 1rem + 2vw, 2rem); }
  }
</style>
