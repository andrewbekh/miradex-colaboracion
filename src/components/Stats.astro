---
// Product facts for partners' clients (strategy 6.1). Numbers come only from the strategy.
// Value on the left, label on the right, two per row: values never wrap.
interface Stat { value: string; label: string }
interface Props { stats: Stat[]; footnote?: string }
const { stats, footnote } = Astro.props;
const swatches = ['mint', 'sky', 'blue'];
---
<div class="st">
  <dl class="st__grid">
    {stats.map((s, i) => (
      <div class="st__item">
        <dt class="st__value"><span class={`st__mark st__mark--${swatches[i % 3]}`} aria-hidden="true"></span>{s.value}</dt>
        <dd class="st__label">{s.label}</dd>
      </div>
    ))}
  </dl>
  {footnote && <p class="st__foot">{footnote}</p>}
</div>

<style>
  .st__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--grid-gap); }
  .st__item {
    display: grid; grid-template-columns: auto 1fr; align-items: center; gap: var(--sp-5);
    padding: var(--sp-5) var(--sp-6); border-radius: var(--radius-md); background: var(--bg); border: 1px solid var(--border);
  }
  .st__value { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--fs-stat); font-weight: var(--fw-medium); line-height: 1; letter-spacing: var(--tracking-caps); white-space: nowrap; min-width: 5.2em; }
  .st__mark { width: 8px; height: 1.1em; border-radius: 2px; flex: none; }
  .st__mark--mint { background: var(--c-mint); }
  .st__mark--sky { background: var(--c-sky); }
  .st__mark--blue { background: var(--c-blue); }
  .st__label { color: var(--text-muted); font-size: var(--fs-body); }
  .st__foot { margin-top: var(--sp-3); font-size: var(--fs-micro); color: var(--text-muted); }
  @media (max-width: 767px) {
    .st__grid { grid-template-columns: 1fr; gap: 10px; }
    .st__item { padding: var(--sp-4); gap: var(--sp-4); }
  }
</style>
