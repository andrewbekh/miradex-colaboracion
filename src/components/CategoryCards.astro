---
import { ui } from '../data/ui';
// Product lines (miradex.bg directions). Photos are provisional until Spanish projects exist.
import Icon from './Icon.astro';
import { productLines } from '../data/nav';
interface Props { linked?: boolean }
// not linked until the Spanish catalogue exists: a «Смотреть каталог» to nowhere reads as broken
const { linked = false } = Astro.props;
---
<ul class="cc" role="list">
  {productLines.map((p) => (
    <li>
      <a class="cc__card" href={linked ? '#' : undefined}>
        <div class:list={['cc__img', { 'cc__img--two': p.images.length > 1 }]}>
          {p.images.map((im) => (
            <div class="cc__photo">
              {im.src ? <img src={im.src} alt={im.alt} loading="lazy" /> : <div class="cc__empty"><Icon name="image" size={32} /></div>}
              {im.label && <span class="cc__label">{im.label}<span class="cc__label-more">{im.labelMore}</span></span>}
            </div>
          ))}
        </div>
        <div class="cc__body">
          <h3 class="cc__title">{p.title}</h3>
          <p class="cc__text">{p.text}</p>
          {linked && <span class="cc__more">{ui.cta.seeCatalog} <Icon name="arrow-up-right" size={16} /></span>}
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .cc { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); }
  .cc > li { display: flex; }
  .cc__card { display: flex; flex-direction: column; width: 100%; color: var(--text); text-decoration: none; border-radius: var(--radius-md); overflow: hidden; background: var(--bg); border: 1px solid var(--border); transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease); }
  a.cc__card[href]:hover { box-shadow: var(--shadow-soft); transform: translateY(-2px); }
  .cc__img { position: relative; display: grid; aspect-ratio: 4 / 3; overflow: hidden; container-type: inline-size; }
  /* a narrow card keeps only the name of the group: the models are in the text under the photo */
  @container (max-width: 320px) { .cc__label-more { display: none; } }
  /* two groups of materials: both visible at once, no switching */
  .cc__img--two { grid-template-columns: 1fr 1fr; gap: 2px; }
  .cc__photo { position: relative; min-width: 0; overflow: hidden; }
  .cc__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  a.cc__card[href]:hover .cc__photo img { transform: scale(1.04); }
  .cc__empty { position: absolute; inset: 0; display: grid; place-items: center; background: var(--c-line); color: var(--c-ink-muted); }
  .cc__label { position: absolute; left: 8px; right: 8px; bottom: 8px; padding: 6px 8px; border-radius: var(--radius-xs); background: var(--c-white); color: var(--c-ink); font-size: var(--fs-micro); font-weight: var(--fw-medium); line-height: 1.2; }
  .cc__body { display: grid; gap: var(--sp-2); padding: var(--sp-5); flex: 1; align-content: start; }
  .cc__title { font-size: var(--fs-h3); }
  .cc__text { color: var(--text-muted); font-size: var(--fs-small); }
  .cc__more { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--sp-2); font-size: var(--fs-micro); font-weight: var(--fw-medium); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  @media (max-width: 1199px) { .cc { grid-template-columns: repeat(3, 1fr); } .cc__body { padding: var(--sp-4); } }
  @media (max-width: 767px) { .cc { grid-template-columns: 1fr; } }
</style>
