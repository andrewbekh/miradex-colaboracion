---
// Icons: lucide-static (stroke) + WhatsApp from simple-icons (brand glyph).
import * as lucide from 'lucide-static';
import { siWhatsapp } from 'simple-icons';

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls = '', label } = Astro.props;

let svg: string;
if (name === 'whatsapp') {
  svg = `<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="${siWhatsapp.path}"/></svg>`;
} else {
  const key = name.split('-').map((p) => p[0].toUpperCase() + p.slice(1)).join('') as keyof typeof lucide;
  svg = (lucide[key] as string | undefined) ?? '';
  if (!svg) throw new Error(`Icon not found: ${name}`);
  svg = svg.replace(/stroke-width="2"/, 'stroke-width="1.6"').replace(/\s(width|height)="24"/g, '').replace(/class="[^"]*"/, '');
}
svg = svg.replace('<svg', `<svg class="icon icon-${name} ${cls}" width="${size}" height="${size}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} focusable="false"`);
---
<Fragment set:html={svg} />
