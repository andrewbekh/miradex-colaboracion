---
// The core of the Spanish model (strategy 1 and 10): national sales, local installation, open partner network.
import Icon from './Icon.astro';
interface Pillar { title: string; text: string; icon?: string }
/** compact: small cards under the hub film (one column on phones, a row of three on the page) */
interface Props { items: Pillar[]; compact?: boolean }
const { items, compact = false } = Astro.props;
// mint to blue: the last card sits right above the mint businesses block
const swatches = ['mint', 'sky', 'blue'];
---
<ol class:list={['mp', { 'mp--compact': compact }]} role="list">
  {items.map((p, i) => (
    <li class={`mp__item mp__item--${swatches[i % 3]}`}>
      {p.icon && <span class="mp__icon"><Icon name={p.icon} size={30} /></span>}
      <h3 class="mp__title">{p.title}</h3>
      <p class="mp__text">{p.text}</p>
    </li>
  ))}
</ol>

<style>
  .mp { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); }
  .mp__item { display: grid; align-content: start; gap: var(--sp-3); padding: var(--sp-6); border-radius: var(--radius-md); color: var(--c-ink); }
  .mp__item--blue { background: var(--c-blue); color: var(--c-white); }
  .mp__item--sky { background: var(--c-sky); color: var(--c-white); }
  .mp__item--mint { background: var(--c-mint); }
  .mp__icon { display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: var(--sp-3); border-radius: var(--radius-md); background: var(--c-white); color: var(--c-ink); }
  .mp__item--blue .mp__icon { color: var(--c-blue); }
  .mp__item--sky .mp__icon { color: #4aa7e0; }
  .mp__title { font-size: var(--fs-h3); }
  .mp--compact { grid-template-columns: 1fr; gap: 8px; }
  /* icon at the top, then title and text across the full card; a bit more room after the text than above the icon */
  .mp--compact .mp__item { display: flex; flex-direction: column; align-items: flex-start; gap: 0; padding: var(--sp-6) var(--sp-6) calc(var(--sp-6) * 1.4); }
  .mp--compact .mp__icon { width: 44px; height: 44px; margin: 0 0 var(--sp-7); border-radius: var(--radius-sm); }
  .mp--compact .mp__text { margin-top: var(--sp-2); }
  .mp--compact .mp__icon :global(svg) { width: 22px; height: 22px; }
  .mp--compact .mp__title { font-size: 1.0625rem; }
  .mp--compact .mp__text { font-size: var(--fs-small); line-height: 1.4; }
  @media (max-width: 1199px) { .mp:not(.mp--compact) { grid-template-columns: 1fr; } .mp:not(.mp--compact) .mp__item { grid-template-columns: 64px 1fr; column-gap: var(--sp-6); align-items: start; } .mp:not(.mp--compact) .mp__icon { grid-row: span 2; margin: 0; } }
  @media (max-width: 767px) { .mp:not(.mp--compact) .mp__item { grid-template-columns: 1fr; padding: var(--sp-5); } .mp:not(.mp--compact) .mp__icon { grid-row: auto; } .mp:not(.mp--compact) .mp__icon { margin-bottom: var(--sp-2); } .mp--compact .mp__item { padding: var(--sp-5) var(--sp-5) calc(var(--sp-5) * 1.4); } }
</style>
