---
// The core of the Spanish model (strategy 1 and 10): national sales, local installation, open partner network.
import Icon from './Icon.astro';
interface Pillar { kicker: string; title: string; text: string; icon?: string }
/** compact: a stacked column next to the hub film */
interface Props { items: Pillar[]; compact?: boolean }
const { items, compact = false } = Astro.props;
const swatches = ['blue', 'sky', 'mint'];
---
<ol class:list={['mp', { 'mp--compact': compact }]} role="list">
  {items.map((p, i) => (
    <li class={`mp__item mp__item--${swatches[i % 3]}`}>
      {p.icon && <span class="mp__icon"><Icon name={p.icon} size={30} /></span>}
      <span class="mp__kicker eyebrow">{p.kicker}</span>
      <h3 class="mp__title">{p.title}</h3>
      <p class="mp__text">{p.text}</p>
    </li>
  ))}
</ol>

<style>
  .mp { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); }
  .mp__item { display: grid; align-content: start; gap: var(--sp-3); padding: var(--sp-6); border-radius: var(--radius-md); color: var(--c-ink); }
  .mp__item--blue { background: var(--c-blue); color: var(--c-white); }
  .mp__item--sky { background: var(--c-sky); color: var(--c-white); }
  .mp__item--mint { background: var(--c-mint); }
  .mp__icon { display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: var(--sp-3); border-radius: var(--radius-md); background: var(--c-white); color: var(--c-ink); }
  .mp__item--blue .mp__icon { color: var(--c-blue); }
  .mp__item--sky .mp__icon { color: #4aa7e0; }
  .mp__kicker { opacity: 0.85; }
  .mp__title { font-size: var(--fs-h3); }
  .mp--compact { grid-template-columns: 1fr; gap: 8px; }
  /* equal heights only next to the film; stacked on smaller screens each card takes its own height */
  @media (min-width: 1024px) { .mp--compact { grid-auto-rows: 1fr; } }
  /* every card the same: icon top left, then kicker, title and text from the same top line */
  .mp--compact .mp__item { grid-template-columns: 44px 1fr; grid-template-rows: auto auto 1fr; column-gap: var(--sp-4); row-gap: 0; align-content: start; align-items: start; padding: var(--sp-5); }
  .mp--compact .mp__icon { grid-row: 1 / span 3; align-self: start; width: 44px; height: 44px; margin: 0; border-radius: var(--radius-sm); }
  .mp--compact .mp__kicker { line-height: 1.4; }
  .mp--compact .mp__title { margin-top: 2px; }
  .mp--compact .mp__text { margin-top: var(--sp-2); }
  .mp--compact .mp__icon :global(svg) { width: 22px; height: 22px; }
  .mp--compact .mp__title { font-size: 1.0625rem; }
  .mp--compact .mp__text { font-size: var(--fs-small); line-height: 1.45; }
  @media (max-width: 1199px) { .mp:not(.mp--compact) { grid-template-columns: 1fr; } .mp:not(.mp--compact) .mp__item { grid-template-columns: 64px 180px 1fr; column-gap: var(--sp-6); align-items: start; } .mp:not(.mp--compact) .mp__icon { grid-row: span 2; margin: 0; } .mp:not(.mp--compact) .mp__kicker { grid-row: span 2; padding-top: 6px; } }
  @media (max-width: 767px) { .mp:not(.mp--compact) .mp__item { grid-template-columns: 1fr; padding: var(--sp-5); } .mp:not(.mp--compact) .mp__icon, .mp:not(.mp--compact) .mp__kicker { grid-row: auto; } .mp:not(.mp--compact) .mp__icon { margin-bottom: var(--sp-2); } .mp:not(.mp--compact) .mp__kicker { padding-top: 0; } .mp--compact .mp__item { padding: var(--sp-4); } }
</style>
