---
// Page section wrapper: tone, spacing, optional brand heading.
import SectionHeading from './SectionHeading.astro';

interface Props {
  id?: string;
  tone?: 'light' | 'tint' | 'grey' | 'blue' | 'mint';
  title?: string;
  eyebrow?: string;
  lead?: string;
  align?: 'start' | 'center';
  tight?: boolean;
  class?: string;
}
const { id, tone = 'light', title, eyebrow, lead, align = 'start', tight = false, class: cls = '' } = Astro.props;
---
<section id={id} class:list={['section', `section--${tone}`, { 'section--tight': tight, 'on-blue': tone === 'blue' }, cls]}>
  <div class="container">
    {title && (
      <SectionHeading title={title} eyebrow={eyebrow} lead={lead} align={align} tone={tone === 'blue' ? 'inverse' : 'light'}>
        <slot name="heading-aside" />
      </SectionHeading>
    )}
    <div class:list={['section__body', { 'section__body--spaced': !!title }]}>
      <slot />
    </div>
  </div>
</section>

<style>
  .section { padding-block: var(--section-top) var(--section-bottom); }
  .section--tight { padding-block: var(--section-top) var(--section-bottom); }
  /* alternate white and grey: the paper tint was too close to white to separate blocks */
  .section--tint { background: var(--bg-grey); }
  .section--grey { background: var(--bg-grey); }
  .section--blue { background: var(--c-blue); color: var(--c-white); }
  .section--mint { background: var(--c-mint); }
  /* no card outlines on coloured backgrounds */
  .section--tint, .section--grey, .section--mint { --card-line: transparent; }
  .section__body--spaced { margin-top: var(--stack-gap); }
</style>
