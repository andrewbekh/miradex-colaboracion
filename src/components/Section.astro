---
// Page section wrapper: tone, spacing, optional brand heading.
import SectionHeading from './SectionHeading.astro';

interface Props {
  id?: string;
  tone?: 'light' | 'tint' | 'dark' | 'blue' | 'mint';
  title?: string;
  eyebrow?: string;
  lead?: string;
  align?: 'start' | 'center';
  tight?: boolean;
  class?: string;
}
const { id, tone = 'light', title, eyebrow, lead, align = 'start', tight = false, class: cls = '' } = Astro.props;
const dark = tone === 'dark';
---
<section id={id} class:list={['section', `section--${tone}`, { 'section--tight': tight, 'on-blue': tone === 'blue' }, cls]}>
  <div class="container">
    {title && (
      <SectionHeading title={title} eyebrow={eyebrow} lead={lead} align={align} tone={dark ? 'dark' : 'light'} seed={id ?? title}>
        <slot name="heading-aside" />
      </SectionHeading>
    )}
    <div class:list={['section__body', { 'section__body--spaced': !!title }]}>
      <slot />
    </div>
  </div>
</section>

<style>
  .section { padding-block: var(--section-y); }
  .section--tight { padding-block: calc(var(--section-y) * 0.6); }
  .section--tint { background: var(--bg-tint); }
  .section--dark { background: var(--bg-dark); color: var(--text-on-dark); }
  .section--blue { background: var(--c-blue); color: var(--c-ink); }
  .section--mint { background: var(--c-mint); }
  .section__body--spaced { margin-top: var(--stack-gap); }
</style>
