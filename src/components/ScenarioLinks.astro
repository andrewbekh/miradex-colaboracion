---
import { ui } from '../data/ui';
// Compact links to other scenarios (landing pages must be self-sufficient but not dead ends).
import Icon from './Icon.astro';
import { scenarios } from '../data/scenarios';
interface Props { ids: string[]; title?: string }
const { ids, title = ui.otherFormat } = Astro.props;
const list = scenarios.filter((s) => ids.includes(s.id));
---
<div class="sl">
  <p class="sl__title">{title}</p>
  <ul class="sl__list" role="list">
    {list.map((s) => (
      <li><a href={s.href}><span class="sl__num">{s.num}</span><span>{s.title}</span><Icon name="arrow-right" size={16} /></a></li>
    ))}
  </ul>
</div>

<style>
  .sl { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-5); align-items: center; padding: var(--sp-5) var(--sp-6); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg); }
  .sl__title { font-weight: var(--fw-medium); }
  .sl__list { display: flex; flex-wrap: wrap; gap: var(--sp-2); justify-content: flex-end; }
  .sl__list a { display: inline-flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); color: var(--text); text-decoration: none; font-size: var(--fs-small); }
  .sl__list a:hover { border-color: var(--c-ink); }
  .sl__num { font-size: 12px; color: var(--text-muted); }
  @media (max-width: 1199px) { .sl { grid-template-columns: 1fr; } .sl__list { justify-content: flex-start; } }
  @media (max-width: 767px) { .sl { padding: var(--sp-5); } .sl__list a { width: 100%; } .sl__list a :global(svg) { margin-left: auto; } }
</style>
