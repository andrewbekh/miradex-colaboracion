---
// Industry page, «Как можно работать с MIRADEX»: only the formats that fit this business (strategy 6.4).
// Each card takes the business entry from that format's landing: its logic and ways of working,
// and links to the format page with this business already open (?type=).
import Icon from './Icon.astro';
import type { Business } from '../data/landings/types';
import type { Scenario } from '../data/scenarios';
import { toneStyle } from '../data/scenarios';
import { ui } from '../data/ui';

interface Props { items: { scenario: Scenario; business: Business }[] }
const { items } = Astro.props;
---
<ul class:list={['sfm', { 'sfm--one': items.length === 1 }]} role="list">
  {items.map(({ scenario: s, business: b }) => (
    <li class="sfm__card">
      <div class="sfm__head">
        <span class="sfm__num" style={toneStyle(s.tone)}>{s.num}</span>
        <h3 class="sfm__title">{s.title}</h3>
      </div>
      <p class="sfm__logic">{b.logic}</p>
      <ul class="sfm__ways" role="list">
        {b.ways.map((w) => (
          <li><span class="sfm__way-title">{w.title}</span><span class="sfm__way-text">{w.text}</span></li>
        ))}
      </ul>
      <a class="sfm__more" href={`${s.href}?type=${b.id}`}><span>{ui.sector.more}</span><Icon name="arrow-right" size={18} /></a>
    </li>
  ))}
</ul>

<style>
  .sfm { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--grid-gap); }
  .sfm--one { grid-template-columns: minmax(0, 720px); }
  .sfm__card { display: flex; flex-direction: column; gap: var(--sp-4); padding: var(--sp-6); border-radius: var(--radius-md); background: var(--c-white); border: 1px solid var(--border); }
  .sfm__head { display: flex; align-items: center; gap: var(--sp-3); }
  .sfm__num { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: var(--radius-sm); font-size: var(--fs-micro); font-weight: var(--fw-medium); }
  .sfm__title { font-size: var(--fs-h3); line-height: 1.2; }
  .sfm__logic { font-size: var(--fs-body); }
  .sfm__ways { display: grid; gap: 8px; }
  .sfm__ways li { display: grid; gap: 2px; padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-sm); background: var(--bg-tint); }
  .sfm__way-title { font-size: var(--fs-small); font-weight: var(--fw-medium); }
  .sfm__way-text { font-size: var(--fs-small); color: var(--text-muted); }
  .sfm__more { margin-top: auto; display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding-top: var(--sp-2); color: var(--c-ink); text-decoration: none; font-size: var(--fs-small); font-weight: var(--fw-medium); letter-spacing: 0.06em; text-transform: uppercase; }
  .sfm__more :global(svg) { transition: transform var(--dur) var(--ease); }
  .sfm__more:hover :global(svg) { transform: translateX(4px); }
  @media (max-width: 767px) {
    .sfm { grid-template-columns: 1fr; }
    .sfm__card { padding: var(--sp-5); }
  }
</style>
