---
// Hub first screen. Left: the offer and the two ways forward, both visible at once:
// pick one of the 5 formats, or leave a short application and we help choose.
// Right: the brand pattern on the brandbook grid (narrow + wide column, the photo takes one square of 5 bands),
// flush with the header and bleeding to the right edge, cropped by the hero height.
// Under 1200px the pattern becomes a thin 3-column strip on top, without the photo.
import Pattern from './Pattern.astro';
import QuickForm from './QuickForm.astro';
import Icon from './Icon.astro';
import { ui } from '../data/ui';
import { scenarios, toneStyle } from '../data/scenarios';

interface Props { title: string; lead: string; image: string }
const { title, lead, image } = Astro.props;
---
<section class="hx">
  <div class="hx__strip" aria-hidden="true"><Pattern seed="hub-strip" layout="wnw" height={4} /></div>
  <div class="container hx__grid">
    <div class="hx__copy">
      <h1 class="h-display hx__title" set:html={title} />
      <p class="lead hx__lead">{lead}</p>

      <nav class="hx__formats" aria-labelledby="hx-formats">
        <p class="hx__label" id="hx-formats">{ui.hubHero.formats}</p>
        <ul class="hx__list" role="list">
          {scenarios.map((s) => (
            <li>
              <a class="hx__fmt" href={s.href}>
                <span class="hx__num" style={toneStyle(s.tone)}>{s.num}</span>
                <span class="hx__name">{s.short}</span>
                <Icon name="arrow-right" size={18} class="hx__arrow" />
              </a>
            </li>
          ))}
          <li>
            <a class="hx__fmt hx__fmt--all" href="#formatos">
              <span class="hx__name">{ui.hubHero.all}</span>
              <Icon name="arrow-down" size={18} class="hx__arrow" />
            </a>
          </li>
        </ul>
      </nav>

      <div class="hx__quick" data-sbar-after>
        <QuickForm uid="hub-quick" title={ui.hubHero.quick} />
      </div>
    </div>

    <div class="hx__visual" aria-hidden="true">
      <Pattern seed="hub-hero" layout="nw" height={14} photo={{ col: 1, from: 2, size: 5, src: image, eager: true }} />
    </div>
  </div>
</section>

<style>
  .hx { position: relative; overflow: clip; }
  .hx__strip { display: none; }
  .hx__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr); gap: clamp(32px, 4vw, 72px); }
  .hx__copy { display: grid; gap: var(--sp-5); align-content: start; padding-block: clamp(32px, 1rem + 2.5vw, 56px) clamp(48px, 1rem + 4vw, 80px); }
  .hx__title { max-width: 15ch; }
  .hx__lead { max-width: 48ch; color: var(--text-muted); }

  .hx__formats { display: grid; gap: var(--sp-3); margin-top: var(--sp-2); }
  .hx__label { font-size: var(--fs-small); font-weight: var(--fw-medium); }
  .hx__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .hx__fmt {
    display: flex; align-items: center; gap: var(--sp-3); height: 52px; padding: 0 14px 0 12px; border-radius: var(--radius-sm);
    background: var(--c-grey); color: var(--c-ink); text-decoration: none; font-size: var(--fs-small); font-weight: var(--fw-medium);
    transition: background-color var(--dur) var(--ease);
  }
  .hx__fmt:hover { background: var(--c-line); }
  .hx__num { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: var(--radius-xs); font-size: 12px; }
  .hx__name { min-width: 0; line-height: 1.2; }
  .hx__fmt :global(.hx__arrow) { margin-left: auto; flex: none; color: var(--c-ink-muted); transition: transform var(--dur) var(--ease), color var(--dur) var(--ease); }
  .hx__fmt:hover :global(.hx__arrow) { transform: translateX(3px); color: var(--c-ink); }
  .hx__fmt--all { background: var(--c-white); border: 1px solid var(--border); }
  .hx__fmt--all:hover { background: var(--c-grey); }
  .hx__fmt--all:hover :global(.hx__arrow) { transform: translateY(2px); }

  .hx__quick { margin-top: var(--sp-2); }

  /* pattern panel: from the header down, to the right edge of the window; cropped by the hero height */
  .hx__visual { position: relative; overflow: hidden; margin-right: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2)); }
  .hx__visual > :global(.pattern) { position: absolute; top: 0; left: 0; right: 0; }

  @media (max-width: 1199px) {
    .hx__strip { display: block; height: clamp(56px, 9vw, 96px); overflow: hidden; }
    .hx__grid { grid-template-columns: 1fr; }
    .hx__visual { display: none; }
    .hx__copy { padding-top: clamp(28px, 5vw, 48px); }
    .hx__title { max-width: 18ch; }
  }
  @media (max-width: 767px) {
    .hx__list { grid-template-columns: 1fr; gap: 6px; }
    .hx__fmt { height: 52px; }
  }
</style>
