---
// Hub first screen: full-bleed photo with the offer on top. Deliberately unlike the landings' split hero,
// so the visitor can tell the hub from a scenario page. The choice itself is the next block (ScenarioBanners).
import Pattern from './Pattern.astro';
import Icon from './Icon.astro';

interface Props { title: string; lead: string; image: string }
const { title, lead, image } = Astro.props;
const facts = [
  { icon: 'factory', text: 'Fábrica en Rumanía' },
  { icon: 'layers', text: 'Acero KG Dongbu Steel' },
  { icon: 'badge-check', text: '1000+ proyectos en la UE' },
  { icon: 'truck', text: 'Entrega en España en 5-10 días' },
];
---
<section class="hh">
  <img class="hh__bg" src={image} alt="" fetchpriority="high" />
  <span class="hh__shade" aria-hidden="true"></span>
  <span class="hh__bands" aria-hidden="true"><Pattern seed="hub-hero" cols={2} units={40} fill narrowFirst /></span>
  <div class="container hh__in">
    <p class="eyebrow hh__eyebrow"><span class="hh__dot" aria-hidden="true"></span>Colaboración MIRADEX · España</p>
    <h1 class="h-display hh__title" set:html={title} />
    <p class="lead hh__lead">{lead}</p>
    <div class="hh__actions">
      <a class="btn btn--primary btn--lg" href="#formatos"><span>Elegir formato</span><Icon name="arrow-down" size={18} /></a>
      <button type="button" class="btn btn--mint btn--lg" data-open-form data-scenario="no-se"><span>Le ayudamos a elegir</span></button>
    </div>
    <ul class="hh__facts" role="list">
      {facts.map((f) => <li><Icon name={f.icon} size={18} />{f.text}</li>)}
    </ul>
  </div>
</section>

<style>
  .hh { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; min-height: min(760px, calc(100svh - 110px)); color: var(--c-white); background: var(--c-ink); }
  .hh__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hh__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(53 53 53 / 0.88) 0%, rgb(53 53 53 / 0.6) 45%, rgb(53 53 53 / 0.1) 80%), linear-gradient(0deg, rgb(53 53 53 / 0.55) 0%, transparent 45%); }
  .hh__bands { position: absolute; top: 0; right: 0; bottom: 0; width: clamp(40px, 6vw, 112px); z-index: -1; }
  .hh__in { padding-block: clamp(48px, 2rem + 5vw, 112px) clamp(40px, 1.5rem + 4vw, 88px); display: grid; gap: var(--sp-5); justify-items: start; }
  .hh__eyebrow { display: inline-flex; align-items: center; gap: 10px; color: rgb(255 255 255 / 0.8); }
  .hh__dot { width: 22px; height: 8px; border-radius: 2px; background: var(--c-mint); }
  .hh__title { max-width: 13ch; }
  .hh__lead { max-width: 44ch; color: rgb(255 255 255 / 0.85); }
  .hh__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-2); }
  .hh__facts { display: flex; flex-wrap: wrap; gap: 6px 8px; margin-top: var(--sp-4); }
  .hh__facts li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px 8px 10px; border-radius: var(--radius-xs); background: rgb(255 255 255 / 0.12); backdrop-filter: blur(6px); font-size: var(--fs-micro); }
  @media (max-width: 767px) {
    .hh { min-height: 0; }
    .hh__shade { background: linear-gradient(0deg, rgb(53 53 53 / 0.92) 0%, rgb(53 53 53 / 0.7) 60%, rgb(53 53 53 / 0.45) 100%); }
    .hh__actions { display: grid; grid-template-columns: 1fr; width: calc(100% - 24px); }
    .hh__in { padding-right: calc(var(--gutter) + 28px); }
  }
</style>
