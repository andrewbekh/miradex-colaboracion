---
// Hub first screen on white. Left: the offer, «how do you want to work with MIRADEX» (5 answers in two columns,
// each opens its format) and a short application on a mint plate. Right: a photo on half of the screen,
// flush with the header and the right edge, cropped by the hero height. Under 1200px the photo is a strip on top.
import QuickForm from './QuickForm.astro';
import Icon from './Icon.astro';
import { ui } from '../data/ui';
import { scenarios, toneStyle } from '../data/scenarios';

interface Props { title: string; lead: string; image: string }
const { title, lead, image } = Astro.props;
---
<section class="hx">
  <div class="container hx__in">
    <div class="hx__copy">
      <div class="hx__head">
        <h1 class="h-display hx__title" set:html={title} />
        <p class="lead hx__lead">{lead}</p>
      </div>

      <nav class="hx__path" aria-labelledby="hx-formats">
        <h2 class="hx__label" id="hx-formats">{ui.hubHero.formats}</h2>
        <ul class="hx__list" role="list">
          {scenarios.map((s) => (
            <li>
              <a class="hx__fmt" href={s.href}>
                <span class="hx__num" style={toneStyle(s.tone)}>{s.num}</span>
                <span class="hx__name">{s.title}</span>
                <Icon name="arrow-right" size={18} class="hx__arrow" />
              </a>
            </li>
          ))}
          <li><a class="hx__fmt hx__fmt--all" href="#formatos"><span class="hx__name">{ui.hubHero.all}</span></a></li>
        </ul>
      </nav>

      <div class="hx__path" data-sbar-after>
        <h2 class="hx__label" id="hx-quick">{ui.hubHero.quick}</h2>
        <QuickForm uid="hub-quick" labelledby="hx-quick" />
      </div>
    </div>

    <div class="hx__photo">
      <img src={image} alt="" fetchpriority="high" />
    </div>
  </div>
</section>

<style>
  .hx { overflow: clip; }
  .hx__in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 4vw, 64px); }
  .hx__copy { display: grid; gap: clamp(24px, 1rem + 1.5vw, 36px); align-content: start; padding-block: clamp(32px, 1rem + 2.5vw, 56px) clamp(40px, 1rem + 3vw, 64px); }
  .hx__head { display: grid; gap: var(--sp-4); }
  .hx__title { max-width: 16ch; }
  .hx__lead { max-width: 48ch; color: var(--text-muted); }

  .hx__path { display: grid; gap: var(--sp-4); }
  .hx__label { font-size: var(--fs-h3); font-weight: var(--fw-medium); line-height: 1.25; text-transform: none; letter-spacing: 0; }

  .hx__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .hx__fmt {
    display: flex; align-items: center; gap: var(--sp-3); height: 100%; min-height: 56px; padding: 8px 14px 8px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--c-white); color: var(--c-ink); text-decoration: none; font-size: var(--fs-small); font-weight: var(--fw-medium);
    transition: border-color var(--dur) var(--ease);
  }
  .hx__fmt:hover { border-color: var(--c-blue); }
  .hx__num { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: var(--radius-xs); font-size: 12px; }
  .hx__name { min-width: 0; line-height: 1.25; }
  /* the arrow shows on hover only */
  .hx__fmt :global(.hx__arrow) { margin-left: auto; flex: none; opacity: 0; transform: translateX(-4px); transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .hx__fmt:hover :global(.hx__arrow), .hx__fmt:focus-visible :global(.hx__arrow) { opacity: 1; transform: none; }
  .hx__fmt--all { padding-left: 16px; color: var(--c-ink-80); }
  .hx__fmt--all:hover { color: var(--c-ink); }

  /* photo: from the header down, to the right edge of the window */
  .hx__photo { position: relative; overflow: hidden; margin-right: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2)); background: var(--c-grey); }
  .hx__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 1199px) {
    .hx__in { grid-template-columns: 1fr; gap: 0; }
    .hx__photo { order: -1; aspect-ratio: 16 / 7; margin-inline: calc(-1 * var(--gutter)); }
  }
  @media (max-width: 767px) {
    .hx__list { grid-template-columns: 1fr; }
    .hx__fmt { min-height: 52px; }
    .hx__photo { aspect-ratio: 16 / 9; }
  }
</style>
