---
// Trust block (grey plate: the brandbook has no black): track record + advantages grid. Used on every landing.
import Section from './Section.astro';
import FeatureGrid from './FeatureGrid.astro';
import { advantages } from '../data/shared';

interface Props { id?: string; title?: string; text?: string }
const {
  id = 'quienes',
  title = '15 лет опыта и 1000+ проектов в ЕС',
  text = 'MIRADEX производит металлические ограждения на собственном заводе в Румынии и поставляет их в страны ЕС на Балканах. Теперь мы выходим в Испанию и ищем партнёров, с которыми построим сильное направление на испанском рынке.',
} = Astro.props;
---
<Section id={id} tone="grey" title={title}>
  <p class="why__lead">{text}</p>
  <div class="why__grid"><FeatureGrid items={advantages} /></div>
</Section>

<style>
  .why__lead { max-width: 62ch; font-size: var(--fs-lead); font-weight: var(--fw-light); line-height: 1.45; }
  .why__grid { margin-top: var(--stack-gap); }
</style>
