---
// Dark positioning block from the reference: "not a startup" + advantages grid. Used on every landing.
import Section from './Section.astro';
import FeatureGrid from './FeatureGrid.astro';
import { advantages } from '../data/shared';

interface Props { id?: string; title?: string; text?: string }
const {
  id = 'quienes',
  title = 'No somos una startup',
  text = 'MIRADEX es un fabricante europeo con más de 15 años de experiencia. Trabajamos en los países balcánicos de la UE y ahora crecemos en España. Buscamos socios que construyan con nosotros un negocio sólido en el mercado español.',
} = Astro.props;
---
<Section id={id} tone="dark" title={title}>
  <p class="why__lead">{text}</p>
  <div class="why__grid"><FeatureGrid items={advantages} tone="dark" /></div>
</Section>

<style>
  .why__lead { max-width: 62ch; font-size: var(--fs-lead); font-weight: var(--fw-light); line-height: 1.45; }
  .why__grid { margin-top: var(--stack-gap); }
</style>
