---
// 5 equal scenario cards + 1 "not sure" tile: 3×2 desktop, 2×3 tablet, 1 column mobile.
import Pattern from './Pattern.astro';
import Icon from './Icon.astro';
import { scenarios } from '../data/scenarios';

interface Props { current?: string; headingLevel?: 'h2' | 'h3'; compact?: boolean }
const { current, headingLevel = 'h3', compact = false } = Astro.props;
const H = headingLevel;
---
<ul class:list={['sg', { 'sg--compact': compact }]} role="list">
  {scenarios.map((s) => (
    <li>
      <a class:list={['sc', { 'sc--current': s.id === current }]} href={s.href} aria-current={s.id === current ? 'page' : undefined}>
        <Pattern seed={`card-${s.id}`} cols={2} units={compact ? 3 : 5} class="sc__pattern" />
        <div class="sc__body">
          <span class="sc__num eyebrow">{s.num}</span>
          <H class="sc__title">{s.title}</H>
          <p class="sc__text">{s.promise}</p>
          {!compact && (
            <ul class="sc__tags" role="list">
              {s.audience.map((a) => <li>{a}</li>)}
            </ul>
          )}
          <span class="sc__more">Ver formato <Icon name="arrow-right" size={18} /></span>
        </div>
      </a>
    </li>
  ))}
  <li>
    <div class="sc sc--ask">
      <Pattern seed="card-ask" cols={2} units={compact ? 3 : 5} class="sc__pattern" narrowFirst />
      <div class="sc__body">
        <span class="sc__num eyebrow">?</span>
        <H class="sc__title">¿No sabe qué formato elegir?</H>
        <p class="sc__text">Cuéntenos sobre su negocio y sus planes: le propondremos el formato y las condiciones según su potencial.</p>
        <button type="button" class="btn btn--primary sc__cta" data-open-form data-scenario="no-se">Contar sobre mi negocio</button>
      </div>
    </div>
  </li>
</ul>

<style>
  .sg { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); }
  .sg > li { display: flex; }
  .sc {
    position: relative; display: flex; flex-direction: column; width: 100%; overflow: hidden; border-radius: var(--radius-md);
    background: var(--bg); border: var(--border-w) solid var(--border);
    color: var(--text); text-decoration: none;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  a.sc:hover { border-color: var(--border); box-shadow: var(--shadow-soft); transform: translateY(-2px); }
  .sc :global(.sc__pattern) { transition: height var(--dur) var(--ease); }
  a.sc:hover :global(.sc__pattern) { --band: 14px; }
  .sc__body { display: flex; flex-direction: column; gap: var(--sp-3); padding: var(--sp-6) var(--sp-6) var(--sp-6); flex: 1; }
  .sc__num { color: var(--text-muted); }
  .sc__title { font-size: var(--fs-h3); max-width: 20ch; }
  .sc__text { color: var(--text-muted); }
  .sc__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--sp-2); }
  .sc__tags li { font-size: var(--fs-micro); padding: 4px 10px; border-radius: var(--radius-xs); background: var(--bg-tint); border: 1px solid var(--border); }
  .sc__more {
    margin-top: auto; padding-top: var(--sp-5); display: inline-flex; align-items: center; gap: 8px;
    font-size: var(--fs-small); font-weight: var(--fw-medium); letter-spacing: 0.06em; text-transform: uppercase;
  }
  .sc__more :global(svg) { transition: transform var(--dur) var(--ease); }
  a.sc:hover .sc__more :global(svg) { transform: translateX(4px); }
  .sc--current { border-color: var(--c-blue); }
  .sg--compact .sc__body { padding: var(--sp-5); gap: var(--sp-2); }
  .sg--compact .sc__more { padding-top: var(--sp-3); }
  .sc--ask { background: var(--bg-dark); border: 0; color: var(--text-on-dark); }
  .sc--ask .sc__num, .sc--ask .sc__text { color: var(--text-on-dark-muted); }
  .sc__cta { margin-top: auto; align-self: flex-start; }

  @media (max-width: 1199px) { .sg { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 767px) {
    .sg { grid-template-columns: 1fr; }
    .sc__body { padding: var(--sp-5); }
  }
</style>
